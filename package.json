{
  "name": "gishistory26",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "validate": "node scripts/validate-content.mjs && node scripts/preserve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate && node scripts/generate-api.mjs && astro check && astro build && pagefind --site dist && node scripts/check-build.mjs",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/dm-sans": "5.2.8",
    "astro": "7.3.8",
    "d3-scale": "4.0.2",
    "graphology": "0.26.0",
    "pagefind": "1.4.0",
    "sigma": "4.0.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/d3-scale": "4.0.9",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
