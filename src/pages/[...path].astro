---
import Layout from '../layouts/Layout.astro';import Sources from '../components/Sources.astro';import RelatedConnections from '../components/RelatedConnections.astro';import SubjectImage from '../components/SubjectImage.astro';import WanangaVideos from '../components/WanangaVideos.svelte';import {ngaPoutamaReadingLinks,ngaPoutamaRecordLinks} from '../lib/nga-poutama-videos.mjs';import {pickRecordImage} from '../lib/subject-media.mjs';import {dataset,passageUrl} from '../lib/data';
export async function getStaticPaths(){const d=await dataset();const readingLinks=ngaPoutamaReadingLinks(d.passages,d.articles);const recordLinks=ngaPoutamaRecordLinks(d.records);return d.records.filter((r:any)=>r.kind!=='Story').map((r:any)=>({params:{path:r.url.replace(/^\//,'').replace(/\/$/,'')},props:{id:r.id}}))}
const d=await dataset();const r=d.records.find((r:any)=>r.id===(Astro.props as {id:string}).id);const passages=d.passages.filter((p:any)=>p.recordIds.includes(r.id));const edges=d.relationships.filter((e:any)=>e.a===r.id||e.b===r.id);const events=d.events.filter((e:any)=>e.recordIds.includes(r.id));const contextual=d.events.filter((e:any)=>!e.recordIds.includes(r.id)&&e.passageIds.some((id:string)=>passages.some((p:any)=>p.id===id)));const subject=r.kind==='Person'?null:pickRecordImage(r,d.images);
---
<Layout title={r.name+' · NZ GIS History'} description={(r.description||r.story?.[0]||r.name).slice(0,160)}><div class="wrap"><a id="return-passage" class="button" href="/read/">← Return to reading</a><p class="eyebrow">{r.category||r.kind}</p><h1>{r.name}</h1>{subject&&<SubjectImage image={subject.image} relation={subject.relation} variant="feature"/>}<div class="record-grid"><article class="narrative" data-pagefind-body ><span class="sr-only" data-pagefind-filter="type">{r.kind}</span>{(r.aliases||[]).map((a:string)=><span class="sr-only">{a} </span>)}{d.themes.filter((t:any)=>r.themeIds?.includes(t.id)).map((t:any)=><span class="sr-only" data-pagefind-filter="theme">{t.title}</span>)}{r.description&&<p>{r.description}</p>}{(r.story||[]).map((p:string,i:number)=><div><p>{p}</p><Sources sources={r.biographyParagraphSources?.[i]?.length?r.biographyParagraphSources[i]:r.paragraphSources?.[i]||[]}/></div>)}{(r.contentSections||[]).map((s:any)=><section><h2>{s.title}</h2>{s.paragraphs?.map((p:string)=><p>{p}</p>)}</section>)}{r.recollections?.length>0&&<section><h2>Personal recollections</h2>{r.recollections.map((p:string)=><blockquote>{p}</blockquote>)}</section>}{r.photoGallery&&<details><summary>{r.photoGallery.title}</summary><p>{r.photoGallery.intro}</p>{r.photoGallery.items.map((i:any)=><section>{i.assetPath&&<a href={i.assetPath}><img src={i.assetPath} alt={i.alt} width={i.width} height={i.height} loading="lazy"/></a>}<p>{i.caption}</p>{i.people?.map((row:any)=><p>{row.label}: {row.ids.map((id:string)=>{const person=d.records.find((x:any)=>x.id===id);return person?<a href={person.url}>{person.name} </a>:null})}</p>)}</section>)}<p>{r.photoGallery.credit}</p></details>}{r.contextLinks?.length>0&&<Sources sources={r.contextLinks} title="Related source links"/>}<Sources sources={r.sources} title="Sources and further reading"/>{r.slug==='nga-poutama-matawhenua'&&<WanangaVideos compact {readingLinks} {recordLinks}/>}{passages.length>0&&<section><h2>Indexed passages</h2><ul class="list">{passages.map((p:any)=><li><a href={passageUrl(p,d.articles)}>{p.title}</a><small>{d.articles.find((a:any)=>a.id===p.articleId)?.title}</small></li>)}</ul></section>}</article><aside><div class="card"><p class="eyebrow">Entry details</p><p>{r.kind}</p>{r.aliases?.length>0&&<details><summary>Other names</summary><ul>{r.aliases.map((a:string)=><li>{a}</li>)}</ul></details>}<a href={'/network/?focus='+encodeURIComponent(r.id)}>Explore connections →</a></div>{events.length>0&&<section><h2>Linked events</h2><ul class="list">{events.map((e:any)=><li><a href={'/timeline/?event='+encodeURIComponent(e.id)}>{e.dateDisplay} · {e.label}</a><small>{e.datePrecision} precision</small></li>)}</ul></section>}{contextual.length>0&&<details><summary>Events in passages indexed with this entry · {contextual.length}</summary><p class="muted">These dates belong to linked passages. They do not establish dates for this entry.</p>{contextual.map((e:any)=><p><a href={'/timeline/?event='+encodeURIComponent(e.id)}>{e.dateDisplay} · {e.label}</a></p>)}</details>}<RelatedConnections {edges} focusId={r.id} records={d.records}/></aside></div></div><script>try{const p=JSON.parse(localStorage.getItem('nzgis-progress')||'null');const a=document.querySelector<HTMLAnchorElement>('#return-passage');const target=new URLSearchParams(location.search).get('from')||p?.url;if(a&&typeof target==='string'&&target.startsWith('/stories/')&&!target.startsWith('//')){const u=new URL(target,location.origin);if(u.origin===location.origin&&u.pathname.startsWith('/stories/'))a.href=u.pathname+u.search+u.hash}}catch{}</script></Layout>
