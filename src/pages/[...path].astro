---
import Layout from '../layouts/Layout.astro';import Sources from '../components/Sources.astro';import {dataset,passageUrl} from '../lib/data';
export async function getStaticPaths(){const d=await dataset();return d.records.filter((r:any)=>r.kind!=='Story').map((r:any)=>({params:{path:r.url.replace(/^\//,'').replace(/\/$/,'')},props:{id:r.id}}))}
const d=await dataset();const r=d.records.find((r:any)=>r.id===(Astro.props as {id:string}).id);const passages=d.passages.filter((p:any)=>p.recordIds.includes(r.id));const edges=d.relationships.filter((e:any)=>e.a===r.id||e.b===r.id);const events=d.events.filter((e:any)=>e.recordIds.includes(r.id));const contextual=d.events.filter((e:any)=>!e.recordIds.includes(r.id)&&e.passageIds.some((id:string)=>passages.some((p:any)=>p.id===id)));
---
<Layout title={r.name+' · NZ GIS History'} description={(r.description||r.story?.[0]||r.name).slice(0,160)}><div class="wrap"><a id="return-passage" class="button" href="/read/">← Return to reading</a><p class="eyebrow">{r.category||r.kind}</p><h1>{r.name}</h1><div class="record-grid"><article class="narrative" data-pagefind-body data-pagefind-filter={`type:${r.kind}`}>{r.description&&<p>{r.description}</p>}{(r.story||[]).map((p:string,i:number)=><div><p>{p}</p><Sources sources={r.biographyParagraphSources?.[i]?.length?r.biographyParagraphSources[i]:r.paragraphSources?.[i]||[]}/></div>)}{(r.contentSections||[]).map((s:any)=><section><h2>{s.title}</h2>{s.paragraphs?.map((p:string)=><p>{p}</p>)}</section>)}{r.recollections?.length>0&&<section><h2>Personal recollections</h2>{r.recollections.map((p:string)=><blockquote>{p}</blockquote>)}</section>}{r.photoGallery&&<details><summary>{r.photoGallery.title}</summary><p>{r.photoGallery.intro}</p>{r.photoGallery.items.map((i:any)=><section><h3>{i.alt}</h3><p>{i.caption}</p></section>)}<p>{r.photoGallery.credit}</p></details>}{r.contextLinks?.length>0&&<Sources sources={r.contextLinks} title="Related source links"/>}<Sources sources={r.sources} title="Sources and further reading"/>{passages.length>0&&<section><h2>Mentioned in the book</h2><ul class="list">{passages.map((p:any)=><li><a href={passageUrl(p,d.articles)}>{p.title}</a><small>{d.articles.find((a:any)=>a.id===p.articleId)?.title}</small></li>)}</ul></section>}</article><aside><div class="card"><p class="eyebrow">Entry details</p><p>{r.kind}</p>{r.aliases?.length>0&&<details><summary>Other names</summary><ul>{r.aliases.map((a:string)=><li>{a}</li>)}</ul></details>}<a href={'/network/?focus='+encodeURIComponent(r.id)}>Explore connections →</a></div>{events.length>0&&<section><h2>Linked events</h2><ul class="list">{events.map((e:any)=><li><a href={'/timeline/?event='+encodeURIComponent(e.id)}>{e.dateDisplay} · {e.label}</a><small>{e.datePrecision} precision</small></li>)}</ul></section>}{contextual.length>0&&<details><summary>Events in passages mentioning this entry · {contextual.length}</summary><p class="muted">These dates belong to linked passages. They do not establish dates for this entry.</p>{contextual.map((e:any)=><p><a href={'/timeline/?event='+encodeURIComponent(e.id)}>{e.dateDisplay} · {e.label}</a></p>)}</details>}{edges.length>0&&<section><h2>Connections</h2><ul class="list">{edges.map((e:any)=>{const other=d.records.find((x:any)=>x.id===(e.a===r.id?e.b:e.a));return <li><small>{e.label}</small><a href={other?.url||'/browse/'}>{other?.name||'Related entry'}</a><details><summary>Connection basis</summary><p>{e.basis}</p><Sources sources={e.sources}/></details></li>})}</ul></section>}</aside></div></div><script>try{const p=JSON.parse(localStorage.getItem('nzgis-progress')||'null');const a=document.querySelector<HTMLAnchorElement>('#return-passage');if(a&&p?.url?.startsWith('/stories/'))a.href=p.url}catch{}</script></Layout>
