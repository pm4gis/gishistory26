---
import Layout from '../../layouts/Layout.astro';
import DecorativeLandscape from '../../components/DecorativeLandscape.astro';
---
<Layout title="Search New Zealand GIS history · NZ GIS History" description="Search chapters, passages, people, organisations, events and sources in A History of GIS in New Zealand."><div class="wrap search-wrap"><div class="visual-page-heading"><div><p class="eyebrow">Find a passage</p><h1>Search the history.</h1></div><DecorativeLandscape id="north2024-hawkes-bay-1" variant="banner" priority/></div><div id="search"></div><noscript><p>Search requires JavaScript. <a href="/read/">Browse all chapters</a> or <a href="/browse/">browse entries</a>.</p></noscript></div><link rel="stylesheet" href="/pagefind/pagefind-ui.css"/><script is:inline src="/pagefind/pagefind-ui.js"></script><script is:inline>window.addEventListener('DOMContentLoaded',()=>{if(!window.PagefindUI)return;const ui=new PagefindUI({element:'#search',showSubResults:true,showImages:false});const root=document.getElementById('search');const query=new URLSearchParams(location.search).get('q');if(query)ui.triggerSearch(query);root.addEventListener('input',e=>{if(!e.target.matches('input[type="search"],.pagefind-ui__search-input'))return;const u=new URL(location.href);if(e.target.value)u.searchParams.set('q',e.target.value);else u.searchParams.delete('q');history.replaceState(null,'',u)});root.addEventListener('click',e=>{if(e.target.closest('.pagefind-ui__search-clear')){const u=new URL(location.href);u.searchParams.delete('q');history.replaceState(null,'',u)}});});</script></Layout>
