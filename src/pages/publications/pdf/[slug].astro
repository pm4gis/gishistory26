---
import Layout from '../../../layouts/Layout.astro';
import PublicationReader from '../../../components/PublicationReader.astro';
import {onlinePdfPublications} from '../../../lib/online-pdf-publications.mjs';
import {publicationReadingContext} from '../../../lib/publication-reading-order.mjs';
export function getStaticPaths(){
 return onlinePdfPublications.map(item=>({params:{slug:item.slug},props:{item,reading:publicationReadingContext('/publications/pdf/'+item.slug+'/')}}));
}
const {item,reading}=Astro.props;
const here='https://history.pm4gis.nz/publications/pdf/'+item.slug+'/';
const structuredData=[{'@type':'CreativeWork',name:item.title,datePublished:item.year,author:{'@type':'Organization',name:item.creator},url:here,description:item.summary,...(item.sourceOnly?{}:{encoding:{'@type':'MediaObject',contentUrl:item.hostedLocally?'https://history.pm4gis.nz'+item.pdfPath:item.pdfPath,encodingFormat:'application/pdf'}})}];
---
<Layout title={item.title+' · NZ GIS History'} description={item.summary} structuredData={structuredData}>
 <PublicationReader title={item.title} pdfPath={item.pdfPath} previous={reading.previous} next={reading.next} position={reading.position} total={reading.total} sourceOnly={item.sourceOnly} sourceUrl={item.sourceUrl} thumbnailPath={item.thumbnailPath}>
  <div class="reference-publication-details">
   <p class="eyebrow"><time datetime={item.year}>{item.year}</time></p>
   <h2>About this publication</h2>
   <p class="creator">{item.creator}</p>
   <p>{item.summary}</p>
   <details class="publication-source-details"><summary>Source information</summary>
    <p>Source: {item.sourceName}.</p>
    <p>{item.attribution}</p>
    {!item.hostedLocally&&<p class="muted">This PDF is served by a publisher or repository, which may restrict embedded viewing.</p>}
    {item.provenance&&<p>{item.provenance}</p>}
    {item.sourceUrl&&<p><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Publisher or repository source record</a></p>}
   </details>
  </div>
 </PublicationReader>
</Layout>
<style>
 .reference-publication-details{max-width:75ch}
 .reference-publication-details h2{font-size:clamp(21px,2.3vw,28px);margin:1.5em 0 .45em}
 .reference-publication-details .creator{font-weight:600}
</style>
