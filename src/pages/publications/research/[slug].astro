---
import Layout from '../../../layouts/Layout.astro';
import {onlinePdfPublications} from '../../../lib/online-pdf-publications.mjs';
import {publicationNavigation} from '../../../lib/pdf-browsing.mjs';

export function getStaticPaths(){
  return onlinePdfPublications.map(item=>({
    params:{slug:item.slug},
    props:{item,navigation:publicationNavigation('research:'+item.slug)}
  }));
}
const {item,navigation}=Astro.props;
const pdfAvailable=String(item.pdfPath).toLowerCase().split('?')[0].split('#')[0].endsWith('.pdf');
const structuredData=[{
  '@type':'CreativeWork',
  '@id':'https://history.pm4gis.nz/publications/research/'+item.slug+'/',
  name:item.title,
  headline:item.title,
  datePublished:item.year,
  description:item.summary,
  ...(pdfAvailable?{encoding:{'@type':'MediaObject',contentUrl:item.pdfPath,encodingFormat:'application/pdf'}}:{})
}];
---
<Layout title={item.title+' · Publications'} description={item.summary} structuredData={structuredData}>
 <article class="page-wrap research-publication" data-pagefind-body>
  <p><a href="/publications/">All publications</a></p>
  <p class="eyebrow">{item.date} · {item.kind}</p>
  <h1 class="page-title">{item.title}</h1>
  <p>{item.creator}</p>
  <p>{item.summary}</p>
  <p class="muted">Source: {item.sourceName}</p>
  {navigation&&<nav class="publication-reader-nav" aria-label="Browse PDF publications">
   {navigation.previous?<a href={navigation.previous.url}>← Previous publication · {navigation.previous.title}</a>:<span>First publication in this sequence</span>}
   <span class="publication-position">{navigation.position} of {navigation.total}</span>
   {navigation.next?<a href={navigation.next.url}>{navigation.next.title} · Next publication →</a>:<span>Last publication in this sequence</span>}
  </nav>}
  <h2 id="read-document">{pdfAvailable?'Read the PDF':'Source document'}</h2>
  {pdfAvailable
   ? <object data={item.pdfPath} type="application/pdf" class="publication-viewer" aria-label={'PDF viewer: '+item.title}><p>Your browser could not display the PDF. See the source and reuse information below.</p></object>
   : <div class="source-record-viewer"><p>This catalogue entry points to a source record rather than a direct PDF file address. The record may provide the report as an attachment.</p><p><a href={item.pdfPath} target="_blank" rel="noopener noreferrer">Open the publisher or LINZ source record</a></p></div>}
  {navigation&&<nav class="publication-reader-nav" aria-label="Continue browsing PDF publications">
   {navigation.previous?<a href={navigation.previous.url}>← Previous publication · {navigation.previous.title}</a>:<span>First publication in this sequence</span>}
   <span class="publication-position">{navigation.position} of {navigation.total}</span>
   {navigation.next?<a href={navigation.next.url}>{navigation.next.title} · Next publication →</a>:<span>Last publication in this sequence</span>}
  </nav>}
  <h2>Source and reuse</h2>
  <p>{item.license}</p>
  <p>{item.attribution}</p>
  {item.provenance&&<p>{item.provenance}</p>}
  {item.sourceUrl&&<p><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel||'Publisher source information'}</a></p>}
 </article>
</Layout>
<style>
 .publication-reader-nav{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin:1.25rem 0;padding:1rem;border:1px solid var(--line);border-radius:12px;background:var(--surface);flex-wrap:wrap}
 .publication-reader-nav a{max-width:42%;font-weight:600}
 .publication-position{white-space:nowrap;color:var(--muted)}
 .publication-viewer{width:100%;height:80vh;min-height:400px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
 .source-record-viewer{border:1px solid var(--line);border-radius:14px;background:var(--surface);padding:1.5rem}
 @media(max-width:600px){.publication-reader-nav a{max-width:100%}.publication-viewer{height:65vh}}
</style>
