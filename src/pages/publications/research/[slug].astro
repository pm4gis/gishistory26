---
import Layout from '../../../layouts/Layout.astro';
import {onlinePdfPublications} from '../../../lib/online-pdf-publications.mjs';
import {publicationNavigation} from '../../../lib/pdf-browsing.mjs';

export function getStaticPaths(){
  return onlinePdfPublications.map(item=>({
    params:{slug:item.slug},
    props:{item,navigation:publicationNavigation('research:'+item.slug)}
  }));
}
const {item,navigation}=Astro.props;
const pdfAvailable=Boolean(item.isPdf)||String(item.pdfPath).toLowerCase().split('?')[0].split('#')[0].endsWith('.pdf');
const structuredData=[{
  '@type':'CreativeWork',
  '@id':'https://history.pm4gis.nz/publications/research/'+item.slug+'/',
  name:item.title,
  headline:item.title,
  datePublished:item.year,
  description:item.summary,
  ...(pdfAvailable?{encoding:{'@type':'MediaObject',contentUrl:item.pdfPath,encodingFormat:'application/pdf'}}:{})
}];
---
<Layout title={item.title+' · Publications'} description={item.summary} structuredData={structuredData}>
 <article class="research-publication reader-page" data-pagefind-body>
  <header class="reader-heading">
   <p class="eyebrow">{item.date} · {item.kind}</p>
   <h1 class="page-title">{item.title}</h1>
   <div class="reader-byline"><span>{item.creator}</span><span>{item.sourceName}</span></div>
  </header>
  {navigation&&<nav class="publication-reader-nav" aria-label="Browse PDF publications">
   {navigation.previous?<a href={navigation.previous.url}>← Previous · {navigation.previous.title}</a>:<span>First publication</span>}
   <span class="publication-position">{navigation.position} of {navigation.total}</span>
   {navigation.next?<a href={navigation.next.url}>{navigation.next.title} · Next →</a>:<span>Last publication</span>}
  </nav>}
  {pdfAvailable
   ? <object id="read-document" data={item.pdfPath} type="application/pdf" class="publication-viewer" aria-label={'PDF viewer: '+item.title}><p>Your browser could not display this PDF. <a href={item.pdfPath} target="_blank" rel="noopener noreferrer">Open the publisher PDF in a new tab.</a></p></object>
   : <div id="read-document" class="source-record-viewer"><p>This catalogue entry points to a source record rather than a direct PDF file address.</p><p><a href={item.pdfPath} target="_blank" rel="noopener noreferrer">Open the publisher or LINZ source record</a></p></div>}
  <section class="reader-details">
   <h2>About this publication</h2>
   <p>{item.summary}</p>
   <h2>Source and reuse</h2>
   <p>{item.license}</p>
   <p>{item.attribution}</p>
   {item.provenance&&<p>{item.provenance}</p>}
   {item.sourceUrl&&<p><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel||'Publisher source information'}</a></p>}
  </section>
 </article>
</Layout>
<style>
 .reader-page{width:100%;max-width:none;margin:0;padding:10px clamp(12px,2vw,32px) 42px}
 .reader-heading{max-width:100%;margin:0 auto 8px}
 .reader-heading .eyebrow{margin:0 0 3px}
 .reader-heading .page-title{font-size:clamp(1.35rem,2vw,2rem);line-height:1.12;margin:0;max-width:72ch}
 .reader-byline{display:flex;gap:14px;flex-wrap:wrap;margin-top:5px;color:var(--muted);font-size:.88rem}
 .publication-reader-nav{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:12px;margin:8px 0;padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);font-size:.88rem}
 .publication-reader-nav a{font-weight:650;text-decoration:none;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 .publication-reader-nav a:last-of-type{text-align:right}
 .publication-position{white-space:nowrap;color:var(--muted);font-size:.82rem}
 .publication-viewer{display:block;width:100%;height:calc(100dvh - 215px);min-height:620px;max-height:1100px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
 .source-record-viewer{height:calc(100dvh - 215px);min-height:400px;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:2rem}
 .reader-details{max-width:1000px;margin:34px auto 0}
 @media(max-width:700px){.reader-page{padding:8px 10px 32px}.reader-heading .page-title{font-size:1.45rem}.publication-reader-nav{grid-template-columns:1fr auto;gap:6px}.publication-reader-nav a{white-space:normal}.publication-reader-nav a:first-of-type{grid-column:1}.publication-reader-nav a:last-of-type{grid-column:1}.publication-position{grid-column:2;grid-row:1/3}.publication-viewer{height:calc(100dvh - 245px);min-height:480px}.source-record-viewer{height:calc(100dvh - 245px);min-height:400px}}
</style>