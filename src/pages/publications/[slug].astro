---
import Layout from '../../layouts/Layout.astro';
import PublicationReader from '../../components/PublicationReader.astro';
import {contributedPrimarySources} from '../../lib/contributed-primary-sources.mjs';
import {publicationReadingContext} from '../../lib/publication-reading-order.mjs';
import {dataset} from '../../lib/data';
export function getStaticPaths(){return contributedPrimarySources.map(item=>({params:{slug:item.slug},props:{item,reading:publicationReadingContext(item.publicationUrl)}}));}
const {item,reading}=Astro.props;
const d=await dataset();
const records=d.records.filter((r:any)=>(item.recordIds||[]).includes(r.id));
const themes=d.themes.filter((t:any)=>item.themeIds.includes(t.id));
const images=d.images.filter((i:any)=>i.publicationSlug===item.slug);
const structuredData=[{'@type':'CreativeWork','@id':'https://history.pm4gis.nz'+item.publicationUrl,title:item.title,name:item.title,...(item.format==='PowerPoint'?{}:item.slug==='gis-mapping-wetland-projects-2021'?{author:{'@type':'Person',name:'Duane Wilkins'},publisher:{'@type':'Organization',name:'Manaaki Whenua – Landcare Research'}}:item.slug==='taranaki-cdem-geospatial-strategy-2021'?{author:[{'@type':'Person',name:'Teresa Gordon'},{'@type':'Person',name:'Ed Cook'}],publisher:{'@type':'Organization',name:'Taranaki Civil Defence and Emergency Management Group'}}:{author:{'@type':'Organization',name:item.creator}}),datePublished:item.startDate,url:'https://history.pm4gis.nz'+item.publicationUrl,description:item.summary,encoding:{'@type':'MediaObject',contentUrl:'https://history.pm4gis.nz'+item.viewerPath,encodingFormat:'application/pdf'}}];
---
<Layout title={item.title+' · Publications'} description={item.summary} structuredData={structuredData}>
 <PublicationReader title={item.title} pdfPath={item.viewerPath} previous={reading.previous} next={reading.next} position={reading.position} total={reading.total}>
  <div class="archive-publication-details">
   <p class="eyebrow"><time datetime={item.startDate}>{item.startDate.slice(0,4)}</time></p>
   <h2>About this publication</h2>
   <p class="creator">{item.creator}</p>
   <p>{item.summary}</p>
   <p class="muted">{item.viewerPages} pages</p>
   <details class="publication-extra"><summary>Historical evidence and connections</summary>
    {item.viewingVersionNote&&<p>{item.viewingVersionNote}</p>}
   <h2>Historical evidence</h2>
   <ul>{item.findings.map(f=><li>{f.page}: {f.text}</li>)}</ul>
   <h2>Connected history</h2>
   <p><a href={'/stories/'+item.article+'/'}>Read the related historical chapter</a> · <a href={'/timeline/?event=source-'+item.slug}>View the publication event on the timeline</a></p>
   <ul>{records.map((r:any)=><li><a href={r.url}>{r.name}</a></li>)}{themes.map((t:any)=><li><a href={'/themes/'+t.slug+'/'}>{t.title}</a></li>)}</ul>
   {images.length>0&&<><h2>Illustrations from this publication</h2><ul>{images.map((i:any)=><li><a href={'/images/'+i.slug+'/'}>{i.title}</a></li>)}</ul></>}
   </details>
   <details class="publication-extra"><summary>Source information</summary>
    <p>{item.filename} · {item.bytes.toLocaleString('en-NZ')} bytes</p>
    <p class="checksum">SHA-256: <code>{item.sha256}</code></p>
   </details>
  </div>
 </PublicationReader>
</Layout>
<style>
 .archive-publication-details{max-width:75ch}
 .archive-publication-details h2{font-size:clamp(21px,2.3vw,28px);margin:1.5em 0 .45em}
 .archive-publication-details .creator{font-weight:600}
 .archive-publication-details li{margin:.65rem 0;line-height:1.6}
 .checksum{overflow-wrap:anywhere}
</style>
