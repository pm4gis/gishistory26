---
import Layout from '../layouts/Layout.astro';
import DecorativeLandscape from '../components/DecorativeLandscape.astro';
import SubjectImage from '../components/SubjectImage.astro';
import {pickThemeImage} from '../lib/subject-media.mjs';
import {homeHighlightSlugs} from '../lib/home-highlights.mjs';
import {homeTopoMaps} from '../lib/home-topo-maps.mjs';
import {decorFor} from '../lib/decor';
import {dataset} from '../lib/data';
import {chapterCardImageMap,homepageFullBleedImageSlugs,homepageMapDetailChapterSlugs} from '../lib/home-chapter-thumbnails.mjs';

const d=await dataset();
const chapters=d.articles.filter((a:any)=>a.status==='published'&&a.slug!=='preface');
const peopleCount=d.records.filter((x:any)=>x.kind==='Person').length;
const chapterNavImages=chapterCardImageMap(chapters,d.passages,d.images);
const eligible=new Set(homeHighlightSlugs);
const chapterPreview=chapters.filter((a:any)=>[1,8,16,24,32,44].includes(a.readingOrder));
const highlights=chapters.filter((a:any)=>eligible.has(a.slug)).map((a:any)=>{
  const passage=d.passages.filter((p:any)=>p.articleId===a.id).sort((x:any,y:any)=>x.order-y.order)[0];
  const images=d.images.filter((img:any)=>img.articleSlug===a.slug&&img.assetPath);
  const image=images.find((img:any)=>img.headerCandidate)||images[0]||null;
  return {...a, passageTitle:passage?.title||a.title, storyUrl:passage?a.url+'#'+encodeURIComponent(passage.slug):a.url, image};
});
if(highlights.length<5)throw new Error('Too few curated published highlighted stories');
const themes=d.themes.map((t:any)=>({...t,subject:pickThemeImage(t.slug,d.images)}));
---
<Layout description="A history of GIS and digital mapping in New Zealand, from early survey computers to Māori GIS, national spatial datasets, web maps and AI in 2025.">
 <div class="wrap home-layout">
  <section class="hero hero--visual hero--topo">
   <div class="hero-documentary-media" data-topo-sources={JSON.stringify(homeTopoMaps.map(({src,alt})=>({src,alt})))} aria-hidden="true">
    <img class="topo-slide is-active" src={homeTopoMaps[0].src} alt="" width="1400" height="788" loading="eager" fetchpriority="high" decoding="async"/>
    <img class="topo-slide" src={homeTopoMaps[1].src} alt="" width="1400" height="788" loading="eager" decoding="async"/>
   </div>
   <div class="hero-copy">
    <p class="eyebrow">Maps · people · technology</p>
    <h1>A history of GIS<br/>in New Zealand.</h1>
    <p class="intro">Explore New Zealand’s move from paper maps to connected spatial data. Start with the short history, then follow the chapters, people and original publications behind it.</p>
    <div class="actions">
     <a class="button primary" href="/history/">Read the short history →</a>
     <a class="button" href="/read/">Browse chapters</a>
     <button type="button" data-hero-motion hidden>Pause background</button>
     <a class="button" id="continue" href="/read/" hidden>Continue reading</a>
    </div>
    <div class="stats" role="group" aria-label="NZ GIS History at a glance. Build figures are measured during this build.">
     <span><strong>{chapters.length}</strong> chapters</span>
     <span><strong>{peopleCount}</strong> people</span>
     <span><strong>{d.events.length}</strong> events</span>
     <span><strong data-build-stat="files">…</strong> files<span class="sr-only"> generated in the verified build</span></span>
     <span><strong data-build-stat="links">…</strong> internal links<span class="sr-only"> checked in the verified build</span></span>
    </div>
   </div>
  </section>

  <section class="card home-summary" aria-label="Other ways to explore">
   <p>Explore dates, people and original documents.</p><div class="actions"><a href="/timeline/">Timeline</a><a href="/browse/">People &amp; organisations</a><a href="/publications/">Publications</a><a href="/search/">Search</a></div>
  </section>

  <section id="highlighted-stories" aria-labelledby="highlights-heading">
   <div class="section-head"><div><p class="eyebrow">Discover something different</p><h2 id="highlights-heading">Highlighted stories</h2></div><a href="/read/">Read the history →</a></div>
   <p class="section-intro">Five starting points, from paper maps to open spatial data. Use Previous and Next, or swipe through the stories.</p>
   <div class="actions story-controls" hidden><button type="button" data-story-prev aria-label="Previous story">← Previous</button><button type="button" data-story-next aria-label="Next story">Next →</button><button type="button" data-story-play aria-pressed="false">Play slideshow</button><span data-story-status role="status" aria-live="polite"></span></div>
   <div class="cards highlight-grid" tabindex="0" aria-label="Historical stories">
    {highlights.map((a:any,i:number)=><article class="card art-card highlight-card" data-highlight={a.slug} hidden={i>=5}>
     {a.image?
      <SubjectImage image={a.image} relation={'Documentary image associated with '+a.title} variant="card" showCaption={false} destination={a.storyUrl}/>:
      <a class="tile-media-link" href={a.storyUrl} aria-label={"Read "+a.passageTitle}><DecorativeLandscape id={decorFor(i+9)} variant="card"/></a>}
     <div class="art-card-body">
      <span class="eyebrow">Chapter {a.readingOrder} · {a.title}</span>
      <a class="title" href={a.storyUrl}>{a.passageTitle}</a>
      <p>{a.summary}</p>
      <a class="read-link" href={a.storyUrl}>Read story →</a>
     </div>
    </article>)}
   </div>
  </section>

  <section id="chapters" aria-labelledby="chapters-heading">
   <div class="section-head"><div><p class="eyebrow">Read the history</p><h2 id="chapters-heading">Explore the chapters</h2></div><a href="/read/">Chapter contents →</a></div>
   <p class="section-intro">A selection from {chapters.length} published chapters. Open the chapter catalogue for the complete chronological history.</p>
   <div class="cards chapter-grid">
    {chapterPreview.map((a:any)=><article class="card chapter-card" id={'chapter-'+a.readingOrder}>
     <a class:list={['chapter-card-media',(chapterNavImages[a.slug]?.homeCardKind==='photo'||homepageFullBleedImageSlugs.has(chapterNavImages[a.slug]?.slug))&&'chapter-card-media--photo',homepageMapDetailChapterSlugs.has(a.slug)&&'chapter-card-media--detail']} href={a.url} aria-label={'Read Chapter '+a.readingOrder+' · '+a.title}>
      {chapterNavImages[a.slug]?
       <img src={chapterNavImages[a.slug].thumbnailPath||chapterNavImages[a.slug].assetPath} alt={chapterNavImages[a.slug].altText} loading="lazy" decoding="async"/>:
       <span class="chapter-image-fallback" aria-hidden="true">Chapter {a.readingOrder}</span>}
     </a>
     <span class="eyebrow">Chapter {a.readingOrder}</span>
     <h3><a href={a.url}>{a.title}</a></h3>
     <p>{a.summary}</p>
     <a class="read-link" href={a.url}>Read chapter →</a>
    </article>)}
   </div>
   <details><summary>All chapter titles</summary><nav class="chapter-preview-contents" aria-label="All chapters">{chapters.map((a:any)=><a id={chapterPreview.includes(a)?undefined:'chapter-'+a.readingOrder} href={a.url}>{a.readingOrder} · {a.title}</a>)}</nav></details>
   <p class="preface-link"><a href="/stories/preface/">Read the author's preface →</a></p>
  </section>

  <section id="themes" aria-labelledby="themes-heading">
   <div class="section-head"><div><p class="eyebrow">Follow a subject</p><h2 id="themes-heading">Explore by theme</h2></div><a href="/themes/">Browse all themes →</a></div>
   <p class="section-intro">Follow subjects across chapters, people, organisations and events.</p>
   <div class="cards cards--visual">
    {themes.map((t:any,i:number)=><article class="card art-card">
     {t.subject?<SubjectImage image={t.subject.image} relation={t.subject.relation} variant="card" showCaption={false} destination={"/themes/"+t.slug+"/"}/>:<a class="tile-media-link" href={"/themes/"+t.slug+"/"} aria-label={"Explore "+t.title}><DecorativeLandscape id={decorFor(i+2)} variant="card"/></a>}
     <div class="art-card-body"><a class="title" href={'/themes/'+t.slug+'/'}>{t.title}</a><p>{t.description}</p></div>
    </article>)}
   </div>
  </section>
 </div>
 <script>
  try{
   const progress=JSON.parse(localStorage.getItem('nzgis-progress')||'null');
   const continued=document.querySelector<HTMLAnchorElement>('#continue');
   if(continued&&progress?.url?.startsWith('/stories/')){continued.href=progress.url;continued.hidden=false;}
  }catch{}
  // Run the image sequence without introducing visible controls or captions.
  // The initial frame changes on every visit; subsequent frames complete a loop.
  const topoMedia=document.querySelector<HTMLElement>('.hero--topo .hero-documentary-media');
  if(topoMedia){
   try{
    const maps=JSON.parse(topoMedia.dataset.topoSources||'[]');
    const frames=Array.from(topoMedia.querySelectorAll<HTMLImageElement>('.topo-slide'));
    if(maps.length>=2&&frames.length===2){
     let index=Math.floor(Math.random()*maps.length);
     let front=0;
     let switching=false;
     frames[0].src=maps[index].src;
     frames[1].src=maps[(index+1)%maps.length].src;
     function advance(){
      if(document.hidden||switching)return;
      switching=true;
      const next=(index+1)%maps.length;
      const incoming=frames[1-front];
      const outgoing=frames[front];
      let finished=false;
      function finish(ok:boolean){
       if(finished)return;
       finished=true;
       incoming.onload=null;
       incoming.onerror=null;
       if(ok){
        incoming.classList.add('is-active');
        outgoing.classList.remove('is-active');
        index=next;
        front=1-front;
       }else index=next;
       switching=false;
      }
      incoming.onload=()=>finish(true);
      incoming.onerror=()=>finish(false);
      incoming.src=maps[next].src;
      if(incoming.complete&&incoming.naturalWidth>0)finish(true);
     }
     let timer=matchMedia('(prefers-reduced-motion: reduce)').matches?undefined:window.setInterval(advance,9000);
     const motion=document.querySelector<HTMLButtonElement>('[data-hero-motion]');
     if(motion){motion.hidden=false;motion.textContent=timer?'Pause background':'Play background';motion.addEventListener('click',()=>{if(timer){clearInterval(timer);timer=undefined;}else timer=window.setInterval(advance,9000);motion.textContent=timer?'Pause background':'Play background';});}
     window.addEventListener('pagehide',()=>window.clearInterval(timer),{once:true});
    }
   }catch{
    // The first server-rendered topographic map remains available without JS.
   }
  }
  const grid=document.querySelector<HTMLElement>('#highlighted-stories .highlight-grid');
  if(grid){
   const cards=Array.from(grid.querySelectorAll<HTMLElement>('.highlight-card'));
   const controls=document.querySelector<HTMLElement>('.story-controls');
   const play=document.querySelector<HTMLButtonElement>('[data-story-play]');
   const status=document.querySelector<HTMLElement>('[data-story-status]');
   const reduced=matchMedia('(prefers-reduced-motion: reduce)');
   let index=0,timer:number|undefined;
   grid.classList.add('story-slider');
   cards.forEach(card=>card.hidden=false);
   if(controls)controls.hidden=false;
   function move(step:number){
    index=(index+step+cards.length)%cards.length;
    grid!.scrollTo({left:cards[index].offsetLeft,behavior:reduced.matches?'instant':'smooth'});
   }
   function stop(){clearInterval(timer);timer=undefined;if(play){play.textContent='Play slideshow';play.setAttribute('aria-pressed','false');}}
   document.querySelector('[data-story-prev]')?.addEventListener('click',()=>{stop();move(-1)});
   document.querySelector('[data-story-next]')?.addEventListener('click',()=>{stop();move(1)});
   play?.addEventListener('click',()=>{
    if(timer){stop();return;}
    play.textContent='Pause slideshow';play.setAttribute('aria-pressed','true');
    timer=window.setInterval(()=>move(1),7000);
   });
   grid.addEventListener('scroll',()=>{
    index=cards.reduce((best,card,i)=>Math.abs(card.offsetLeft-grid!.scrollLeft)<Math.abs(cards[best].offsetLeft-grid!.scrollLeft)?i:best,0);
    if(status)status.textContent=(index+1)+' of '+cards.length;
   },{passive:true});
   grid.addEventListener('keydown',event=>{if(event.target===grid&&(event.key==='ArrowRight'||event.key==='ArrowLeft')){event.preventDefault();stop();move(event.key==='ArrowRight'?1:-1)}});
   grid.addEventListener('focusin',stop);grid.addEventListener('pointerenter',stop);
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop()});
   window.addEventListener('pagehide',stop,{once:true});
   if(status)status.textContent='1 of '+cards.length;
  }
 </script>
</Layout>

<style>
 #chapters .chapter-grid{grid-template-columns:repeat(3,minmax(0,1fr))}#themes .art-card-body p{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}@media(max-width:900px){#chapters .chapter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){#chapters .chapter-grid{grid-template-columns:1fr}}
 .chapter-preview-contents{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:12px;padding:16px 0}
 .story-controls{margin:15px 0}.story-slider{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:18px;padding:4px 4px 20px;position:relative}.story-slider .highlight-card{flex:0 0 min(72vw,370px);scroll-snap-align:start;background:color-mix(in srgb,var(--surface) 88%,transparent);backdrop-filter:blur(12px)}
 .home-summary{display:flex;align-items:center;justify-content:space-between;gap:18px 32px;margin:30px 0 42px;padding:24px 30px}
 .home-summary h2{margin:3px 0 10px}
 .home-summary p:not(.eyebrow){margin:0;max-width:90ch}
 .home-summary .button{flex-shrink:0}
 @media(max-width:800px){.home-summary{display:block;padding:21px}.home-summary .button{margin-top:15px}}
</style>
