---
import Layout from '../layouts/Layout.astro';
import {dataset} from '../lib/data';
import {decorUrl} from '../lib/decor';
const d=await dataset();
const chapters=d.articles.filter((a:any)=>a.status==='published'&&a.slug!=='preface');
const chapterPreview=chapters.filter((a:any)=>[1,8,16,24,32,44].includes(a.readingOrder));
const peopleCount=d.records.filter((r:any)=>r.kind==='Person').length;
const maps=chapters.find((a:any)=>a.slug==='what-the-computer-inherited');
const computers=chapters.find((a:any)=>a.slug==='when-gis-became-gis');
const satellite=d.images.find((i:any)=>i.slug==='nasa-landsat4-tasman-1990');
const map=d.images.find((i:any)=>i.slug==='tuki-map-1793-1798');
const workstation=d.images.find((i:any)=>i.slug==='intergraph-clix-workstation');
if(!maps||!computers||!satellite?.assetPath||!map?.assetPath||!workstation?.assetPath)throw new Error('Missing accepted homepage feature or image');
---
<Layout homepage description="A history of GIS and digital mapping in New Zealand, from survey records and early computers to national spatial datasets, web maps and AI in 2025.">
 <div class="home-layout">
  <section class="landing-hero" aria-labelledby="landing-title">
   <div class="landing-image landing-image--first" aria-hidden="true"><img src={satellite.assetPath} alt="" width="1600" height="1600" loading="eager" fetchpriority="high" decoding="async"/></div>
   <div class="landing-image landing-image--second" aria-hidden="true"><img src={decorUrl('north2024-raglan1')} alt="" width="1600" height="900" loading="eager" decoding="async"/></div>
   <div class="landing-image landing-image--third" aria-hidden="true"><img src={decorUrl('north2024-taranaki1')} alt="" width="1600" height="900" loading="eager" decoding="async"/></div>
   <div class="landing-copy">
    <h1 id="landing-title">A history of GIS<br/>in New Zealand</h1>
    <p class="landing-intro">The maps, machines and people behind<br class="wide-break"/> New Zealand’s geographic information systems.</p>
    <div class="landing-actions"><a class="landing-primary" href="/read/">Explore the chapters <span aria-hidden="true">→</span></a><a href="/timeline/">View the timeline <span aria-hidden="true">→</span></a><a id="continue" href="/read/" hidden>Continue reading →</a></div>
   </div>
   <div class="landing-bottom">
    <div class="landing-stats" role="group" aria-label="NZ GIS History at a glance. Build figures are measured during this build.">
     <span><strong>{chapters.length}</strong> chapters</span><span><strong>{peopleCount}</strong> people</span><span><strong>{d.events.length}</strong> events</span>
     <span><strong data-build-stat="files">…</strong> files<span class="sr-only"> generated in the verified build</span></span>
     <span><strong data-build-stat="links">…</strong> internal links<span class="sr-only"> checked in the verified build</span></span>
    </div>
    <div class="landing-credits">
     <a class="landing-credit landing-credit--first" href={'/images/'+satellite.slug+'/'}>Tasman Glacier · Landsat · NASA, 1990</a>
     <span class="landing-credit landing-credit--second">Raglan · supplied aerial landscape imagery, 2024</span>
     <span class="landing-credit landing-credit--third">Taranaki · supplied aerial landscape imagery, 2024</span>
    </div>
   </div>
  </section>

  <section class="history-features" id="highlighted-stories" aria-labelledby="features-heading">
   <div class="feature-introduction"><p class="eyebrow">Explore the history</p><h2 id="features-heading">From paper maps<br/>to digital systems</h2></div>
   <figure class="map-artefact">
    <a href={maps.url} aria-label="Read Maps before computers"><img src={map.assetPath} alt={map.altText} width="720" height="960" loading="lazy" decoding="async"/></a>
    <figcaption><a href={'/images/'+map.slug+'/'}>Tuki’s map, 1793 · Image details</a></figcaption>
   </figure>
   <article class="map-feature"><h3><a href={maps.url}>Maps before computers</a></h3><p>Explore the survey plans, aerial photographs and census boundaries that preceded digital mapping.</p><a class="feature-link" href={maps.url}>Read chapter <span aria-hidden="true">→</span></a></article>
   <article class="computer-feature">
    <figure><a href={computers.url} aria-label="Read When GIS became GIS"><img src={workstation.assetPath} alt={workstation.altText} width="495" height="363" loading="lazy" decoding="async"/></a><figcaption><a href={'/images/'+workstation.slug+'/'}>Intergraph workstation · Image details</a></figcaption></figure>
    <div class="computer-copy"><h3><a href={computers.url}>When GIS became GIS</a></h3><p>The equipment, software and growing community that brought geographic information onto the computer.</p><a class="feature-link" href={computers.url}>Read chapter <span aria-hidden="true">→</span></a></div>
   </article>
  </section>

  <section class="landscape-interlude" aria-labelledby="landscape-heading">
   <div class="landscape-photo" aria-hidden="true"><img src={decorUrl('north2024-atene1')} alt="" width="1600" height="900" loading="lazy" decoding="async"/></div>
   <div class="landscape-glass">
    <p class="eyebrow">Seeing the land differently</p>
    <h2 id="landscape-heading">From the air,<br/>a different map</h2>
    <p>Aerial surveys, satellite imagery and later LiDAR changed how New Zealand's landscapes could be recorded and analysed. Follow the changing techniques, and the people who put them to work.</p>
    <a href="/themes/imagery/">Explore aerial photography and imagery <span aria-hidden="true">↗</span></a>
   </div>
   <p class="landscape-caption">Atene · supplied North Island landscape imagery, 2024</p>
  </section>

  <section id="chapters" class="landing-chapters" aria-labelledby="chapters-heading">
   <h2 class="eyebrow" id="chapters-heading">Read the history</h2>
   <nav class="chapter-preview" aria-label="Selected chapters">{chapterPreview.map((a:any)=><a id={'chapter-'+a.readingOrder} href={a.url}><span class="chapter-number">{String(a.readingOrder).padStart(2,'0')}</span><span>{a.title}</span></a>)}</nav>
   <div class="chapter-options"><a class="feature-link" href="/read/">All {chapters.length} chapters →</a><a href="/stories/preface/">Author’s preface →</a></div>
   <details class="all-chapters"><summary>All chapter titles</summary><nav class="chapter-preview-contents" aria-label="All chapters">{chapters.map((a:any)=><a id={chapterPreview.includes(a)?undefined:'chapter-'+a.readingOrder} href={a.url}>{a.readingOrder} · {a.title}</a>)}</nav></details>
  </section>
  <section class="people-editorial" aria-labelledby="people-editorial-heading">
   <div class="people-editorial-image" aria-hidden="true"><img src={decorUrl('north2024-rangitoto1')} alt="" width="1600" height="900" loading="lazy" decoding="async"/></div>
   <div class="people-editorial-copy">
    <p class="eyebrow">Behind the maps</p>
    <h2 id="people-editorial-heading">People made<br/>these systems</h2>
    <p>Surveyors, programmers, cartographers, researchers and communities helped shape GIS in New Zealand. Explore their work through the organisations, projects and historical accounts that connect them.</p>
    <nav aria-label="Explore the people and organisations"><a href="/browse/?kind=Person">People <span aria-hidden="true">↗</span></a><a href="/browse/?kind=Organisation&amp;kind=Agency&amp;kind=Business&amp;kind=Council&amp;kind=Community">Organisations <span aria-hidden="true">↗</span></a></nav>
   </div>
  </section>

  <section id="themes" class="landing-themes" aria-labelledby="themes-heading"><h2 class="eyebrow" id="themes-heading">Follow a subject</h2><nav aria-label="Historical themes">{d.themes.map((t:any)=><a href={'/themes/'+t.slug+'/'}>{t.title} <span aria-hidden="true">↗</span></a>)}</nav></section>
  <p class="history-endpoint">History through 31 December 2025</p>
 </div>
 <script>
  try{
   const progress=JSON.parse(localStorage.getItem('nzgis-progress')||'null');
   const continued=document.querySelector<HTMLAnchorElement>('#continue');
   if(continued&&typeof progress?.url==='string'&&progress.url.startsWith('/stories/')){continued.href=progress.url;continued.hidden=false;}
  }catch{}
 </script>
</Layout>
<style>
 .home-layout{--home-gutter:clamp(24px,4.6vw,76px);max-width:1800px;margin:0 auto;overflow:clip;background:var(--bg)}
 .landing-hero{--hero-end:#081725;position:relative;isolation:isolate;min-height:640px;background:var(--hero-end);color:#f5f5ed;display:flex;flex-direction:column;justify-content:space-between;padding:84px var(--home-gutter) 36px;overflow:hidden}
 .landing-image{position:absolute;inset:0;z-index:-2;opacity:0;will-change:opacity}
 .landing-image--first,.landing-credit--first{animation:hero-first 27s linear infinite}
 .landing-image--second,.landing-credit--second{animation:hero-second 27s linear infinite}
 .landing-image--third,.landing-credit--third{animation:hero-third 27s linear infinite}
 @keyframes hero-first{0%,29%{opacity:1}34%,96%{opacity:0}100%{opacity:1}}
 @keyframes hero-second{0%,29%{opacity:0}34%,62%{opacity:1}67%,100%{opacity:0}}
 @keyframes hero-third{0%,62%{opacity:0}67%,96%{opacity:1}100%{opacity:0}}
 .landing-credits{position:relative;min-height:36px;min-width:min(280px,100%);text-align:right}
 .landing-credits .landing-credit{display:block;position:absolute;inset:0 0 auto auto;opacity:0;text-align:right}
 .landing-hero{background:#081725}

 .landing-image img{width:100%;height:100%;object-fit:cover;object-position:center 44%;display:block}
 .landing-hero::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#081725 0%,#081725d9 24%,#0817256b 51%,#08172500 77%),linear-gradient(0deg,var(--hero-end) 0%,color-mix(in srgb,var(--hero-end) 90%,transparent) 3%,#08172500 40%)}
 .landing-copy{position:relative;max-width:870px}
 .landing-copy h1{font-size:clamp(48px,6.3vw,96px);font-weight:720;letter-spacing:-.045em;line-height:1.04;margin:0 0 24px;text-wrap:balance}
 .landing-intro{font-size:clamp(18px,1.85vw,26px);line-height:1.5;max-width:46ch;margin:0 0 30px;color:#f0f2ed}
 .landing-actions{display:flex;align-items:center;flex-wrap:wrap;gap:18px 28px}
 .landing-actions a{display:inline-flex;gap:16px;align-items:center;min-height:48px;text-decoration:none;color:#b9ebff;font-size:16px;font-weight:600}
 .landing-actions .landing-primary{background:#b9ebff;color:#092032;border-radius:5px;padding:12px 24px;box-shadow:0 8px 24px #0003}
 .landing-actions a:hover{text-decoration:underline;text-underline-offset:5px}
 .landing-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-top:78px}
 .landing-stats{display:flex;flex-wrap:wrap;gap:16px clamp(22px,3.1vw,52px);font-size:14px;color:#bed7e5}
 .landing-stats>span{display:flex;flex-direction:column;line-height:1.5}
 .landing-stats strong{font-size:clamp(24px,2.2vw,32px);line-height:1.2;font-weight:650;color:#f5f5ed;margin-bottom:4px}
 .landing-credit{max-width:250px;font-size:12px;color:#f5f5ed;line-height:1.5;text-decoration:none;text-align:right;text-shadow:0 1px 4px #000}
 .landing-credit:hover{text-decoration:underline}
 .landscape-interlude{background:#081725;position:relative;min-height:clamp(530px,48vw,740px);isolation:isolate;color:#fff;display:flex;align-items:center;padding:clamp(34px,5vw,90px) var(--home-gutter);overflow:hidden}
 .landscape-photo{position:absolute;inset:0;z-index:-2}
 .landscape-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
 .landscape-interlude::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#071522a8 0%,#07152252 48%,transparent 85%),linear-gradient(0deg,#07152275,transparent 44%)}
 .landscape-glass{max-width:600px;padding:clamp(26px,3vw,46px);border:1px solid #ffffff59;background:#0b1c2e8f;box-shadow:0 22px 75px #0005,inset 0 1px #ffffff30;border-radius:22px;backdrop-filter:blur(17px);-webkit-backdrop-filter:blur(17px)}
 .landscape-glass .eyebrow{color:#c1e8fe;margin:0 0 14px}
 .landscape-glass h2{font-size:clamp(41px,5vw,72px);line-height:1.07;font-weight:640;letter-spacing:-.045em;margin:0 0 24px;color:#fff}
 .landscape-glass p:not(.eyebrow){font-size:clamp(17px,1.5vw,20px);line-height:1.6;margin:0 0 26px}
 .landscape-glass a{display:inline-flex;gap:14px;align-items:center;color:#cef2ff;text-decoration:none;font-size:16px;font-weight:650;min-height:44px}
 .landscape-glass a:hover{text-decoration:underline}
 .landscape-caption{position:absolute;right:var(--home-gutter);bottom:18px;font-size:12px;line-height:1.5;color:#fff;opacity:.88;text-shadow:0 2px 8px #000}
 .people-editorial{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:0;margin:44px 0 36px;min-height:510px}
 .people-editorial-image{height:100%;min-height:510px;overflow:hidden}
 .people-editorial-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
 .people-editorial-copy{position:relative;margin-left:clamp(-100px,-6vw,-45px);margin-right:var(--home-gutter);padding:clamp(30px,4vw,62px);background:color-mix(in srgb,var(--surface) 83%,transparent);border:1px solid color-mix(in srgb,var(--line) 54%,transparent);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:22px;box-shadow:0 22px 70px #0003,inset 0 1px #fff2}
 .people-editorial-copy h2{font-size:clamp(36px,4vw,60px);line-height:1.08;letter-spacing:-.035em;margin:12px 0 20px}
 .people-editorial-copy p:not(.eyebrow){font-size:18px;line-height:1.6;color:var(--muted)}
 .people-editorial-copy nav{display:flex;flex-wrap:wrap;gap:12px 28px;margin-top:24px}
 .people-editorial-copy nav a{display:inline-flex;gap:9px;align-items:center;text-decoration:none;font-weight:650;font-size:16px;min-height:44px}
 .people-editorial-copy nav a:hover{text-decoration:underline}

 .history-features{padding:28px var(--home-gutter) 20px;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);grid-template-rows:auto auto 1fr;column-gap:clamp(38px,5vw,96px);position:relative}
 .feature-introduction{grid-column:2;grid-row:1;padding-top:16px}
 .feature-introduction .eyebrow{margin:0 0 12px}
 .feature-introduction h2{font-size:clamp(38px,4.5vw,68px);line-height:1.06;letter-spacing:-.04em;margin:0 0 32px;font-weight:650}
 .map-artefact{grid-column:1;grid-row:1/4;align-self:start;position:relative;margin:-22px 0 0;transform:rotate(-4deg);transform-origin:center}
 .map-artefact img{display:block;width:100%;height:auto;box-shadow:0 24px 46px #0003}
 .map-artefact figcaption{font-size:12px;line-height:1.5;padding:12px 6px;transform:rotate(4deg);transform-origin:left}
 .history-features figcaption a{color:var(--muted);text-decoration:none}.history-features figcaption a:hover{text-decoration:underline}
 .map-feature{grid-column:2;grid-row:2;max-width:42ch}
 .history-features h3{font-size:clamp(24px,2.4vw,34px);letter-spacing:-.025em;line-height:1.2;margin:0 0 12px}
 .history-features h3 a{color:var(--text);text-decoration:none}.history-features h3 a:hover{color:var(--link)}
 .history-features p:not(.eyebrow){font-size:18px;line-height:1.6;margin:0 0 14px;color:var(--muted)}
 .feature-link{font-size:16px;font-weight:650;text-decoration:none;color:var(--link);display:inline-flex;align-items:center;min-height:44px;gap:10px}
 .feature-link:hover{text-decoration:underline;text-underline-offset:5px}
 .computer-feature{grid-column:2;grid-row:3;margin-top:14px;min-width:0}
 .computer-feature figure{margin:0 0 12px 16%;position:relative}
 .computer-feature img{display:block;width:100%;height:auto;mask-image:linear-gradient(0deg,transparent 0%,#000 12%,#000 88%,transparent 100%);-webkit-mask-image:linear-gradient(0deg,transparent 0%,#000 12%,#000 88%,transparent 100%)}
 .computer-feature figcaption{font-size:12px;text-align:right;margin:0;line-height:1.5}
 .computer-copy{max-width:45ch;margin-top:-4px}
 .landing-chapters{padding:34px var(--home-gutter) 10px}
 .landing-chapters .eyebrow,.landing-themes .eyebrow{font-size:12px;line-height:1.5;margin:0 0 22px}
 .chapter-preview{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(22px,3vw,46px)}
 .chapter-preview a{display:flex;flex-direction:column;gap:6px;color:var(--text);text-decoration:none;font-size:17px;line-height:1.35;padding-bottom:20px;border-bottom:1px solid var(--line);scroll-margin-top:100px}
 .chapter-preview a:hover{color:var(--link);border-color:var(--accent)}
 .chapter-number{font-size:15px;color:var(--muted)}
 .chapter-options{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:12px}.chapter-options>a:last-child{font-size:14px}
 .all-chapters{margin-top:14px;font-size:14px}.all-chapters>summary{min-height:44px;cursor:pointer;color:var(--muted);width:fit-content;padding-block:10px}
 .chapter-preview-contents{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:8px 30px;padding-block:16px}
 .chapter-preview-contents a{padding-block:8px;scroll-margin-top:100px}
 .landing-themes{padding:32px var(--home-gutter) 0}.landing-themes nav{display:flex;gap:8px 32px;flex-wrap:wrap;max-width:1120px}
 .landing-themes nav a{display:inline-flex;align-items:center;gap:10px;min-height:44px;text-decoration:none;color:var(--muted);font-size:15px}.landing-themes nav a:hover{color:var(--link);text-decoration:underline}
 .history-endpoint{font-size:12px;color:var(--muted);padding:20px var(--home-gutter) 4px;margin:0}
 :global(html[data-appearance="dark"]) .landing-hero{--hero-end:var(--bg)}
 @media(min-width:1181px){.landing-hero{margin-top:-94px;padding-top:160px;min-height:720px}}
 @media(min-width:1600px){.landing-hero{min-height:780px}.history-features{padding-top:40px}}
 @media(max-width:1000px){.landing-hero{min-height:600px;padding-top:70px}.landing-copy h1{font-size:clamp(48px,6.3vw,70px)}.landing-bottom{flex-wrap:wrap;margin-top:65px}.landing-credit{max-width:none;text-align:left}.history-features{column-gap:38px}.feature-introduction h2{font-size:44px}.history-features p:not(.eyebrow){font-size:17px}.map-artefact{margin-top:18px}.chapter-preview{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 30px}}
 @media(max-width:650px){
  .home-layout{--home-gutter:24px}.landing-hero{padding-top:48px;padding-bottom:30px;min-height:650px}
  .landing-image img{object-position:62% center}.landing-hero::before{background:linear-gradient(90deg,#081725d9,#08172566),linear-gradient(0deg,var(--hero-end) 0%,color-mix(in srgb,var(--hero-end) 85%,transparent) 16%,#08172500 68%)}
  .landing-copy h1{font-size:clamp(38px,9.8vw,58px);line-height:1.07;margin-bottom:22px}.landing-intro{font-size:18px;line-height:1.5;max-width:29ch}.wide-break{display:none}
  .landing-actions{gap:10px 22px}.landing-actions a{font-size:15px}.landing-actions .landing-primary{padding:10px 18px}
  .landing-bottom{margin-top:62px;gap:20px}.landing-credits{min-width:100%;text-align:left}.landing-credits .landing-credit{inset:0 auto auto 0;text-align:left}.landing-stats{column-gap:26px;row-gap:16px}.landing-stats>span{font-size:12px}.landing-stats strong{font-size:25px}.landing-credit{font-size:11px}
  .history-features{display:flex;flex-direction:column;padding-top:38px;padding-bottom:0;gap:0}
  .feature-introduction{order:0;padding:0}.feature-introduction h2{font-size:clamp(34px,9vw,46px);margin-bottom:28px}
  .map-artefact{order:1;width:68%;max-width:340px;margin:4px 0 20px 6px;transform:rotate(-4deg)}
  .map-feature{order:2;align-self:flex-end;width:90%;margin:0 0 30px}.history-features h3{font-size:25px}
  .computer-feature{order:3;margin:0}.computer-feature figure{margin:0 0 12px 7%;width:93%}.computer-copy{max-width:34ch}
  .landscape-interlude{min-height:600px;align-items:end;padding-bottom:64px}.landscape-glass{padding:25px 24px;border-radius:16px}.landscape-caption{left:var(--home-gutter);right:auto;bottom:10px}
  .people-editorial{display:block;min-height:0;margin:36px 0 24px}.people-editorial-image{min-height:0;height:330px}.people-editorial-copy{margin:-65px var(--home-gutter) 0;padding:26px 24px;border-radius:16px}.people-editorial-copy p:not(.eyebrow){font-size:16px}
  .landing-chapters{padding-top:40px}.chapter-preview{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 24px}.chapter-preview a{font-size:16px;padding-bottom:14px;min-height:82px}
  .chapter-options{align-items:flex-start;flex-direction:column;gap:3px}.landing-themes{padding-top:22px}.landing-themes nav{display:block}.landing-themes nav a{display:flex;justify-content:space-between;font-size:15px}.history-endpoint{padding-top:24px;padding-bottom:12px}
 }
 @media(prefers-reduced-motion:reduce){.landing-image,.landing-credits .landing-credit{animation:none!important}.landing-image--first,.landing-credit--first{opacity:1}.landing-image--second,.landing-image--third,.landing-credit--second,.landing-credit--third{opacity:0}}
 @media(prefers-reduced-transparency:reduce){.landscape-glass{background:#0b1c2eea;backdrop-filter:none}.people-editorial-copy{background:var(--surface);backdrop-filter:none}} 
 @media(prefers-reduced-transparency:reduce){.landing-hero::before{background:linear-gradient(90deg,#081725 0%,#081725db 55%,#08172580 100%)}.computer-feature img{mask-image:none;-webkit-mask-image:none}}
</style>
