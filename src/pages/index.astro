---
import Layout from '../layouts/Layout.astro';
import DecorativeLandscape from '../components/DecorativeLandscape.astro';
import SubjectImage from '../components/SubjectImage.astro';
import {pickThemeImage} from '../lib/subject-media.mjs';
import {homeHighlightSlugs} from '../lib/home-highlights.mjs';
import {homeTopoMaps} from '../lib/home-topo-maps.mjs';
import {decorFor} from '../lib/decor';
import {dataset} from '../lib/data';
import {chapterCardImageMap,homepageFullBleedImageSlugs,homepageMapDetailChapterSlugs} from '../lib/home-chapter-thumbnails.mjs';

const d=await dataset();
const chapters=d.articles.filter((a:any)=>a.status==='published'&&a.slug!=='preface');
const peopleCount=d.records.filter((x:any)=>x.kind==='Person').length;
const chapterNavImages=chapterCardImageMap(chapters,d.passages,d.images);
const eligible=new Set(homeHighlightSlugs);
const highlights=chapters.filter((a:any)=>eligible.has(a.slug)).map((a:any)=>{
  const passage=d.passages.filter((p:any)=>p.articleId===a.id).sort((x:any,y:any)=>x.order-y.order)[0];
  const images=d.images.filter((img:any)=>img.articleSlug===a.slug&&img.assetPath);
  const image=images.find((img:any)=>img.headerCandidate)||images[0]||null;
  return {...a, passageTitle:passage?.title||a.title, storyUrl:passage?a.url+'#'+encodeURIComponent(passage.slug):a.url, image};
});
if(highlights.length<10)throw new Error('Too few curated published highlighted stories');
const themes=d.themes.map((t:any)=>({...t,subject:pickThemeImage(t.slug,d.images)}));
---
<Layout>
 <div class="wrap home-layout">
  <section class="hero hero--visual hero--topo">
   <div class="hero-documentary-media" data-topo-sources={JSON.stringify(homeTopoMaps.map(({src,alt})=>({src,alt})))} aria-hidden="true">
    <img class="topo-slide is-active" src={homeTopoMaps[0].src} alt="" width="1400" height="788" loading="eager" fetchpriority="high" decoding="async"/>
    <img class="topo-slide" src={homeTopoMaps[1].src} alt="" width="1400" height="788" loading="eager" decoding="async"/>
   </div>
   <div class="hero-copy">
    <p class="eyebrow">Maps · people · technology</p>
    <h1>A history of GIS<br/>in New Zealand.</h1>
    <p class="intro">Read the chapters in sequence, explore a period, or follow the people and organisations behind the work.</p>
    <div class="actions">
     <a class="button primary" href={chapters[0]?.url||'/read/'}>Start reading →</a>
     <a class="button" href="/timeline/">Explore the timeline</a>
     <a class="button" id="continue" href="/read/" hidden>Continue reading</a>
    </div>
    <div class="stats" role="group" aria-label="NZ GIS History at a glance. Build figures are from the latest verified build.">
     <span><strong>{chapters.length}</strong> chapters</span>
     <span><strong>{peopleCount}</strong> people</span>
     <span><strong>{d.events.length}</strong> events</span>
     <span><strong>9,108</strong> generated files<span class="sr-only"> in the latest verified build</span></span>
     <span><strong>237,886</strong> internal links<span class="sr-only"> checked in the latest verified build</span></span>
     <span><strong>{d.records.length}</strong> catalogue records</span>
    </div>
   </div>
  </section>

  <section id="highlighted-stories" aria-labelledby="highlights-heading">
   <div class="section-head"><div><p class="eyebrow">Discover something different</p><h2 id="highlights-heading">Highlighted stories</h2></div><a href="/read/">Read the history →</a></div>
   <p class="section-intro">Five selections from across New Zealand's GIS history.</p>
   <div class="cards highlight-grid">
    {highlights.map((a:any,i:number)=><article class="card art-card highlight-card" data-highlight={a.slug} hidden={i>=5}>
     {a.image?
      <SubjectImage image={a.image} relation={'Documentary image associated with '+a.title} variant="card" showCaption={false} destination={a.storyUrl}/>:
      <a class="tile-media-link" href={a.storyUrl} aria-label={"Read "+a.passageTitle}><DecorativeLandscape id={decorFor(i+9)} variant="card"/></a>}
     <div class="art-card-body">
      <span class="eyebrow">Chapter {a.readingOrder} · {a.title}</span>
      <a class="title" href={a.storyUrl}>{a.passageTitle}</a>
      <p>{a.summary}</p>
      <a class="read-link" href={a.storyUrl}>Read story →</a>
     </div>
    </article>)}
   </div>
  </section>

  <section id="chapters" aria-labelledby="chapters-heading">
   <div class="section-head"><div><p class="eyebrow">Read the history</p><h2 id="chapters-heading">Explore the chapters</h2></div><a href="/read/">Chapter contents →</a></div>
   <p class="section-intro">All {chapters.length} published chapters, in reading order. Choose a chapter or jump straight to its number.</p>
   <nav class="chapter-index" aria-label="Jump to a chapter">
    {chapters.map((a:any)=><a href={'#chapter-'+a.readingOrder} aria-label={'Jump to chapter '+a.readingOrder}>{a.readingOrder}</a>)}
   </nav>
   <div class="cards chapter-grid">
    {chapters.map((a:any)=><article class="card chapter-card" id={'chapter-'+a.readingOrder}>
     <a class:list={['chapter-card-media',(chapterNavImages[a.slug]?.homeCardKind==='photo'||homepageFullBleedImageSlugs.has(chapterNavImages[a.slug]?.slug))&&'chapter-card-media--photo',homepageMapDetailChapterSlugs.has(a.slug)&&'chapter-card-media--detail']} href={a.url} aria-label={'Read Chapter '+a.readingOrder+' · '+a.title}>
      {chapterNavImages[a.slug]?
       <img src={chapterNavImages[a.slug].thumbnailPath||chapterNavImages[a.slug].assetPath} alt={chapterNavImages[a.slug].altText} loading="lazy" decoding="async"/>:
       <span class="chapter-image-fallback" aria-hidden="true">Chapter {a.readingOrder}</span>}
     </a>
     <span class="eyebrow">Chapter {a.readingOrder}</span>
     <h3><a href={a.url}>{a.title}</a></h3>
     <p>{a.summary}</p>
     <a class="read-link" href={a.url}>Read chapter →</a>
    </article>)}
   </div>
   <p class="preface-link"><a href="/stories/preface/">Read the author's preface →</a></p>
  </section>

  <section id="themes" aria-labelledby="themes-heading">
   <div class="section-head"><div><p class="eyebrow">Follow a subject</p><h2 id="themes-heading">Explore by theme</h2></div><a href="/themes/">Browse all themes →</a></div>
   <p class="section-intro">Follow subjects across chapters, people, organisations and events.</p>
   <div class="cards cards--visual">
    {themes.map((t:any,i:number)=><article class="card art-card">
     {t.subject?<SubjectImage image={t.subject.image} relation={t.subject.relation} variant="card" showCaption={false} destination={"/themes/"+t.slug+"/"}/>:<a class="tile-media-link" href={"/themes/"+t.slug+"/"} aria-label={"Explore "+t.title}><DecorativeLandscape id={decorFor(i+2)} variant="card"/></a>}
     <div class="art-card-body"><a class="title" href={'/themes/'+t.slug+'/'}>{t.title}</a><p>{t.description}</p></div>
    </article>)}
   </div>
  </section>
 </div>
 <script>
  try{
   const progress=JSON.parse(localStorage.getItem('nzgis-progress')||'null');
   const continued=document.querySelector<HTMLAnchorElement>('#continue');
   if(continued&&progress?.url?.startsWith('/stories/')){continued.href=progress.url;continued.hidden=false;}
  }catch{}
  // Run the image sequence without introducing visible controls or captions.
  // The initial frame changes on every visit; subsequent frames complete a loop.
  const topoMedia=document.querySelector<HTMLElement>('.hero--topo .hero-documentary-media');
  if(topoMedia){
   try{
    const maps=JSON.parse(topoMedia.dataset.topoSources||'[]');
    const frames=Array.from(topoMedia.querySelectorAll<HTMLImageElement>('.topo-slide'));
    if(maps.length===20&&frames.length===2){
     let index=Math.floor(Math.random()*maps.length);
     let front=0;
     let switching=false;
     frames[0].src=maps[index].src;
     frames[1].src=maps[(index+1)%maps.length].src;
     function advance(){
      if(document.hidden||switching)return;
      switching=true;
      const next=(index+1)%maps.length;
      const incoming=frames[1-front];
      const outgoing=frames[front];
      let finished=false;
      function finish(ok:boolean){
       if(finished)return;
       finished=true;
       incoming.onload=null;
       incoming.onerror=null;
       if(ok){
        incoming.classList.add('is-active');
        outgoing.classList.remove('is-active');
        index=next;
        front=1-front;
       }else index=next;
       switching=false;
      }
      incoming.onload=()=>finish(true);
      incoming.onerror=()=>finish(false);
      incoming.src=maps[next].src;
      if(incoming.complete&&incoming.naturalWidth>0)finish(true);
     }
     const timer=window.setInterval(advance,9000);
     window.addEventListener('pagehide',()=>window.clearInterval(timer),{once:true});
    }
   }catch{
    // The first server-rendered topographic map remains available without JS.
   }
  }
  const grid=document.querySelector<HTMLElement>('#highlighted-stories .highlight-grid');
  if(grid){
   const cards=Array.from(grid.querySelectorAll<HTMLElement>('.highlight-card'));
   try{
    const previous=JSON.parse(sessionStorage.getItem('nzgis-last-highlights')||'[]');
    const unused=cards.filter(card=>!Array.isArray(previous)||!previous.includes(card.dataset.highlight));
    const choices=unused.length>=5?unused:[...cards];
    for(let i=choices.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[choices[i],choices[j]]=[choices[j],choices[i]];}
    const selected=choices.slice(0,5);
    cards.forEach(card=>card.hidden=!selected.includes(card));
    selected.forEach(card=>grid.appendChild(card));
    sessionStorage.setItem('nzgis-last-highlights',JSON.stringify(selected.map(card=>card.dataset.highlight)));
   }catch{
    // The first five server-rendered stories remain visible when storage is unavailable.
   }
  }
 </script>
</Layout>
