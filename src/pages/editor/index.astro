---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Prepare an editorial draft · NZ GIS History" robots="noindex,follow"><div class="wrap"><p class="eyebrow">Editorial fallback</p><h1>Prepare a draft.</h1><p class="intro">Make a content correction and download a draft for ChatGPT to validate and publish. This screen preserves undisplayed fields and cannot change the live publication.</p><label>Collection<select id="collection"><option value="passages">Reading passages</option><option value="records">People and organisations</option><option value="articles">Chapters</option><option value="events">Events</option></select></label><label>Entry<select id="entry" style="display:block;width:100%;margin:20px 0"></select></label><form id="editor-form"></form><div class="actions"><button id="draft">Download draft</button><button id="reset">Discard changes</button></div><p id="editor-status" aria-live="polite"></p><p class="muted">Changes remain on this device until you give the draft to ChatGPT. Sources and permanent IDs are retained. Publishing uses the checked GitHub workflow.</p></div><script>
let data:any;let selected:any;let original:any;let revision='';const c=document.querySelector<HTMLSelectElement>('#collection')!;const entry=document.querySelector<HTMLSelectElement>('#entry')!;const form=document.getElementById('editor-form')!;const status=document.getElementById('editor-status')!;
async function init(){try{const res=await fetch('/editor-data.json');if(!res.ok)throw Error('Content unavailable');const body=await res.json();data=body.data;revision=body.revision;chooseCollection()}catch{status.textContent='Draft data unavailable. Ask ChatGPT to retrieve the latest repository content.'}}
function field(label:string,value:string,change:(v:string)=>void){const wrap=document.createElement('label');wrap.textContent=label;wrap.style.display='block';wrap.style.marginBottom='22px';const input=document.createElement('textarea');input.value=value;input.rows=6;input.style.cssText='width:100%;padding:14px;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:8px;font:inherit;line-height:1.6;display:block;margin-top:10px';input.addEventListener('input',()=>change(input.value));wrap.append(input);form.append(wrap)}
function chooseCollection(){entry.replaceChildren();for(const item of data[c.value]){const option=document.createElement('option');option.value=item.id;option.textContent=item.title||item.name||item.label;entry.append(option)}edit()}
function edit(){original=data[c.value].find((x:any)=>x.id===entry.value);selected=structuredClone(original);form.replaceChildren();status.textContent='Draft only. Base revision '+revision.slice(0,12);if(c.value==='passages'){field('Passage title',selected.title,v=>selected.title=v);selected.blocks?.forEach((b:any,i:number)=>{if(b.type==='paragraph')field('Paragraph '+(i+1),b.text,v=>{b.text=v;if('markdown'in b)b.markdown=v})})}else if(c.value==='records'){field('Entry name',selected.name,v=>selected.name=v);selected.story?.forEach((p:string,i:number)=>field('Account paragraph '+(i+1),p,v=>selected.story[i]=v))}else if(c.value==='articles'){field('Chapter title',selected.title,v=>selected.title=v);field('Summary',selected.summary,v=>selected.summary=v)}else{field('Event title',selected.label,v=>selected.label=v);field('Summary',selected.summary,v=>selected.summary=v)}}
c.addEventListener('change',chooseCollection);entry.addEventListener('change',edit);document.getElementById('reset')!.addEventListener('click',edit);form.addEventListener('submit',e=>e.preventDefault());document.getElementById('draft')!.addEventListener('click',()=>{if(!selected)return;const draft={schemaVersion:1,baseRevision:revision,status:'unvalidated-editorial-draft',operations:[{action:'replace',collection:c.value,value:selected,acceptedEditorialChange:false}]};const blob=new Blob([JSON.stringify(draft,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='NZ_GIS_History_Editorial_Draft.json';a.click();URL.revokeObjectURL(url);status.textContent='Draft downloaded. Ask ChatGPT to compare it with the latest revision, validate it and prepare a preview.'});init();
</script></Layout>
