---
import Layout from '../../layouts/Layout.astro';
import DecorativeLandscape from '../../components/DecorativeLandscape.astro';
import SubjectImage from '../../components/SubjectImage.astro';
import {pickThemeImage} from '../../lib/subject-media.mjs';
import {decorFor} from '../../lib/decor';
import {dataset} from '../../lib/data';
const d=await dataset();
const thematic=d.themes.map((t:any)=>({...t,subject:pickThemeImage(t.slug,d.images)}));
---
<Layout title="Themes in New Zealand GIS history · NZ GIS History" description="Explore thematic reading paths through the people, projects, technology, datasets and events that shaped GIS in New Zealand.">
 <div class="wrap">
  <div class="visual-page-heading">
    <div><p class="eyebrow">Reading collections</p><h1>Explore a theme.</h1><p class="intro">Follow a subject through the people, organisations, technology and accounts of New Zealand's GIS history.</p></div>
    <DecorativeLandscape id="north2024-karikari2" variant="banner" priority/>
  </div>
  <div class="cards cards--visual">{thematic.map((t:any,i:number)=>
    <article class="card art-card">
      {t.subject?<SubjectImage image={t.subject.image} relation={t.subject.relation} variant="card"/>:<DecorativeLandscape id={decorFor(i+2)} variant="card"/>}
      <div class="art-card-body"><a class="title" href={'/themes/'+t.slug+'/'}>{t.title}</a><p>{t.description}</p></div>
    </article>)}
  </div>
 </div>
</Layout>
