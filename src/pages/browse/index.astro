---
import Layout from '../../layouts/Layout.astro';import Browse from '../../components/Browse.svelte';import {dataset} from '../../lib/data';const d=await dataset();
---
<Layout title="People and organisations · NZ GIS History"><div class="wrap"><p class="eyebrow">Connected entries</p><h1>People & organisations.</h1><p class="intro">Find people, businesses, agencies, councils and projects. Follow their accounts, sources and connections.</p><Browse client:load records={d.records.map((r:any)=>({id:r.id,name:r.name,kind:r.kind,url:r.url,aliases:r.aliases,themeIds:r.themeIds,description:(r.description||r.story?.[0]||'').slice(0,200)}))} themes={d.themes}/></div></Layout>
