---
import {isListedRecord} from '../../lib/record-listing.mjs';
import Layout from '../../layouts/Layout.astro';
import DecorativeLandscape from '../../components/DecorativeLandscape.astro';
import {pickRecordImage} from '../../lib/subject-media.mjs';
import Browse from '../../components/Browse.svelte';
import {dataset} from '../../lib/data';
import {decorFor,decorUrl} from '../../lib/decor';
const d=await dataset();
const passageCounts=new Map<string,number>();
for(const passage of d.passages as any[])for(const id of passage.recordIds||[])passageCounts.set(id,(passageCounts.get(id)||0)+1);
const connectionCounts=new Map<string,number>();
for(const edge of d.relationships as any[]){
 connectionCounts.set(edge.a,(connectionCounts.get(edge.a)||0)+1);
 connectionCounts.set(edge.b,(connectionCounts.get(edge.b)||0)+1);
}
const browseRecords=d.records.filter(isListedRecord).map((r:any,i:number)=>({
 fallbackImage:decorUrl(decorFor(i),"card"),
 id:r.id,name:r.name,kind:r.kind,url:r.url,aliases:r.aliases,themeIds:r.themeIds,
 chapterCount:passageCounts.get(r.id)||0,
 connectionCount:connectionCounts.get(r.id)||0,
 description:(r.description||r.story?.[0]||'').slice(0,200),
 featuredImage:(()=>{const selected=pickRecordImage(r,d.images);return selected?{src:selected.image.thumbnailPath||selected.image.assetPath,title:selected.image.title,alt:selected.image.altText,sourceUrl:'/images/'+selected.image.slug+'/',relation:selected.relation}:null})()
}));
---
<Layout title="People and organisations · NZ GIS History">
 <div class="wrap">
  <div class="visual-page-heading"><div><p class="eyebrow">Connected entries</p><h1>People &amp; organisations.</h1><p class="intro">Find people, businesses, agencies, councils and projects. Follow their accounts, sources and connections.</p></div><DecorativeLandscape id="porirua-teawarua-o-porirua" variant="banner" priority/></div>
  <p><a href="/directory/">Browse the complete alphabetical index of people, organisations and datasets →</a></p>
  <Browse client:load records={browseRecords} themes={d.themes}/>
 </div>
</Layout>
