---
import Layout from '../../layouts/Layout.astro';
import DecorativeLandscape from '../../components/DecorativeLandscape.astro';import {pickRecordImage} from '../../lib/subject-media.mjs';import Browse from '../../components/Browse.svelte';import {dataset} from '../../lib/data';const d=await dataset();
---
<Layout title="People and organisations · NZ GIS History" description="Browse the people, businesses, government agencies, councils and projects that shaped geographic information systems in New Zealand."><div class="wrap"><div class="visual-page-heading"><div><p class="eyebrow">Connected entries</p><h1>People & organisations.</h1><p class="intro">Find people, businesses, agencies, councils and projects. Follow their accounts, sources and connections.</p></div><DecorativeLandscape id="porirua-teawarua-o-porirua" variant="banner" priority/></div><Browse client:load records={d.records.map((r:any)=>({id:r.id,name:r.name,kind:r.kind,url:r.url,aliases:r.aliases,themeIds:r.themeIds,description:(r.description||r.story?.[0]||'').slice(0,200),featuredImage:(()=>{const selected=pickRecordImage(r,d.images);return selected?{src:selected.image.thumbnailPath||selected.image.assetPath,title:selected.image.title,alt:selected.image.altText,sourceUrl:'/images/'+selected.image.slug+'/',relation:selected.relation}:null})()}))} themes={d.themes}/></div></Layout>
