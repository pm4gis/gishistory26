---
import Layout from '../../layouts/Layout.astro';import {dataset} from '../../lib/data';const d=await dataset();
---
<Layout title="People and project connections · NZ GIS History" description="Explore documented links between people, organisations, projects and events in the history of geographic information systems in New Zealand."><div class="wrap"><p class="eyebrow">Optional network view</p><h1>Explore connections.</h1><p class="intro">Choose an entry to view its immediate neighbours. Read each relationship's basis and sources in the list below.</p><label>Entry<select id="focus" style="display:block;width:100%;margin:15px 0">{d.records.map((r:any)=><option value={r.id}>{r.name}</option>)}</select></label><button id="load-network">Open visual network</button><p id="network-status" aria-live="polite"></p><div id="graph" class="network-canvas" hidden></div><ul class="list" id="connections"></ul></div><script define:vars={{records:d.records.map((r:any)=>({id:r.id,name:r.name,kind:r.kind,url:r.url})),edges:d.relationships}}>window.__network={records,edges};</script><script>import {initNetwork} from '../../lib/network';initNetwork();</script></Layout>
