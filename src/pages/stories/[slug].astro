---
import Layout from '../../layouts/Layout.astro';import Reader from '../../components/Reader.svelte';import {dataset} from '../../lib/data';import {chapterSchema} from '../../lib/seo.mjs';import {decorFor,decorUrl} from '../../lib/decor';import {chapterNavImageMap} from '../../lib/chapter-nav-media.mjs';
export async function getStaticPaths(){const d=await dataset();return d.articles.filter((a:any)=>a.status==='published').map((a:any)=>({params:{slug:a.slug},props:{id:a.id}}))}
const d=await dataset();const a=d.articles.find((a:any)=>a.id===(Astro.props as {id:string}).id);const passages=d.passages.filter((p:any)=>p.articleId===a.id).sort((x:any,y:any)=>x.order-y.order);const ids=new Set(passages.flatMap((p:any)=>p.recordIds));const related=d.records.filter((r:any)=>ids.has(r.id)&&r.kind!=='Story');const events=d.events.filter((e:any)=>e.passageIds.some((id:string)=>passages.some((p:any)=>p.id===id)));const edges=d.relationships.filter((e:any)=>ids.has(e.a)&&ids.has(e.b));const index=d.articles.findIndex((x:any)=>x.id===a.id);const decorSrc=decorUrl(decorFor(index+3));const chapterNavImages=chapterNavImageMap(d.articles,d.passages,d.images);const structuredData=chapterSchema(a,passages,related);
---
<Layout title={a.title+' · NZ GIS History'} description={a.summary} structuredData={structuredData}><Reader client:load article={a} passages={passages} records={related} events={events} relationships={edges} decorSrc={decorSrc} images={d.images} themes={d.themes} previous={d.articles[index-1]} next={d.articles[index+1]} chapterNavImages={chapterNavImages}/></Layout>
