---
import Layout from '../../layouts/Layout.astro';
import DecorativeLandscape from '../../components/DecorativeLandscape.astro';import {dataset} from '../../lib/data';const d=await dataset();
---
<Layout title="Book contents · NZ GIS History" description="Read the New Zealand GIS history book chapter by chapter, from early maps and surveying to modern spatial data, web maps and AI."><div class="wrap"><div class="visual-page-heading"><div><p class="eyebrow">The book</p><h1>Choose a chapter.</h1><p class="intro">Read in sequence or start with a topic. Each chapter links to its people, organisations and events.</p></div><DecorativeLandscape id="otago-8" variant="banner" priority/></div><ol class="list">{d.articles.map((a:any)=><li><a href={a.url}>{a.slug==='preface'?'Preface':`Chapter ${a.readingOrder}`} · {a.title}</a><small>{a.summary}</small></li>)}</ol></div></Layout>
