---
import Layout from '../../layouts/Layout.astro';
import DecorativeLandscape from '../../components/DecorativeLandscape.astro';
import {dataset} from '../../lib/data';
import {chapterCardImageMap,homepageFullBleedImageSlugs,homepageMapDetailChapterSlugs} from '../../lib/home-chapter-thumbnails.mjs';
const d=await dataset();
const chapters=d.articles.filter((a:any)=>a.status==='published'&&a.slug!=='preface');
const navImages=chapterCardImageMap(chapters,d.passages,d.images);
---
<Layout title="Chapters · NZ GIS History" description="Read every published chapter in A History of GIS in New Zealand, in sequence or by subject.">
 <div class="wrap">
  <div class="visual-page-heading">
   <div><p class="eyebrow">Read the history</p><h1>Explore the chapters.</h1><p class="intro">Read in sequence or start with a topic. Each chapter connects to the people, organisations and events described.</p></div>
   <DecorativeLandscape id="otago-8" variant="banner" priority/>
  </div>
  <p>New to the subject? <a href="/history/">Read the short history first</a>, or choose any chapter below.</p>
  <p><a href="/stories/preface/">Read the author's preface →</a></p>
  <div class="chapter-catalogue" aria-label="Chapter catalogue">
   {chapters.map((a:any)=><a class="chapter-catalogue-card" id={'chapter-'+a.readingOrder} href={a.url}>
    <span class:list={['chapter-image-slot',(navImages[a.slug]?.homeCardKind==='photo'||homepageFullBleedImageSlugs.has(navImages[a.slug]?.slug))&&'chapter-card-media--photo',homepageMapDetailChapterSlugs.has(a.slug)&&'chapter-card-media--detail']}>
     {navImages[a.slug]?
      <img src={navImages[a.slug].thumbnailPath||navImages[a.slug].assetPath} alt={navImages[a.slug].altText} loading="lazy" decoding="async"/>:
      <span class="chapter-image-fallback" aria-hidden="true">Chapter {a.readingOrder}</span>}
    </span>
    <span class="chapter-catalogue-copy">
     <span class="eyebrow">Chapter {a.readingOrder}</span>
     <strong>{a.title}</strong>
     <span class="chapter-catalogue-summary">{a.summary}</span>
     <span class="chapter-catalogue-arrow">Read chapter →</span>
    </span>
   </a>)}
  </div>
 </div>
</Layout>
