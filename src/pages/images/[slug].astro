---
import Layout from "../../layouts/Layout.astro";
import {imageSchema} from "../../lib/seo.mjs";
import { getCollection } from "astro:content";
import {reviewedImagePassages,curatedImageParagraphs} from "../../lib/chapter-media.mjs";

export async function getStaticPaths() {
  const images = await getCollection("images");
  return images.map((entry) => ({ params: { slug: entry.data.slug }, props: { imageId: entry.data.id } }));
}
const { imageId } = Astro.props;
const entries = await getCollection("images");
const image = entries.find((entry) => entry.data.id === imageId)?.data;
// The original articleSlug was sometimes a broad acquisition category, not
// a verified relationship. Link back only after a paragraph/passage is known.
const reviewed = image ? (reviewedImagePassages as Record<string,{articleSlug:string;afterParagraphId:string}>)[image.slug] : null;
const earlierAnchor = (typeof image?.afterParagraphId === "string" ? image.afterParagraphId : "") ||
  (image ? (curatedImageParagraphs as Record<string,string>)[image.slug] : undefined);
const explicitPassageId = typeof image?.passageId === "string" ? image.passageId : "";
const explicitPassageSlug = typeof image?.passageSlug === "string" ? image.passageSlug : "";
const linkedArticle = reviewed?.articleSlug || ((earlierAnchor || explicitPassageId || explicitPassageSlug) ? image?.articleSlug : null);
const relatedChapter = linkedArticle ? (await getCollection("articles")).find((entry) => entry.data.slug === linkedArticle)?.data : null;
const linkedAnchor = reviewed?.afterParagraphId || earlierAnchor || explicitPassageSlug;
const illustratedPassageUrl = relatedChapter ? relatedChapter.url + (linkedAnchor ? '#'+linkedAnchor : '') : null;
---
{image ? <Layout title={`${image.title} — Image details`} description={`${image.title}. ${image.credit}. Source and licence details.`} structuredData={imageSchema(image)}>
  <article class="image-detail page-wrap">
    <p class="eyebrow">Image archive <span aria-hidden="true">/</span> Image details</p>
    <h1 class="page-title">{image.title}</h1>
    <figure class="image-detail-figure"><img src={image.assetPath} alt={image.altText} width={image.originalWidth} height={image.originalHeight} decoding="async" /><figcaption>{image.caption || image.title} Credit: {image.credit}</figcaption></figure>
    {image.context && <section aria-labelledby="image-context-heading"><h2 id="image-context-heading">About this image</h2><p>{image.context}</p></section>}
    {relatedChapter && <p><a class="text-link" href={illustratedPassageUrl}>Read the illustrated passage in {relatedChapter.title} →</a></p>}
    {image.relatedRecords && image.relatedRecords.length > 0 && <section aria-labelledby="image-connections-heading"><h2 id="image-connections-heading">Connected records</h2><ul class="image-connected-records">{image.relatedRecords.map((record) => <li><a href={record.url}>{record.name}</a>{record.role && <span> · {record.role}</span>}</li>)}</ul></section>}
    {image.originalAssetPath && <p><a class="button" href={image.originalAssetPath} download>Download the original locally stored image</a></p>}
    <section class="image-source-card" aria-labelledby="image-source-heading">
      <p class="eyebrow">Attribution</p><h2 id="image-source-heading">Source and reuse</h2>
      <dl><div><dt>Published on</dt><dd><a href={image.sourceUrl} target="_blank" rel="noopener noreferrer">{image.sourceName} <span aria-hidden="true">↗</span></a></dd></div>
        <div><dt>Credit</dt><dd>{image.credit}</dd></div>
        {image.dateDisplay && <div><dt>Image date</dt><dd>{image.dateDisplay}</dd></div>}
        {image.sourceOriginalUrl && <div><dt>Original file source</dt><dd><a href={image.sourceOriginalUrl} target="_blank" rel="noopener noreferrer">View the source-original image <span aria-hidden="true">↗</span></a></dd></div>}
        {image.sourceFileTitle && <div><dt>Original source filename</dt><dd>{image.sourceFileTitle}</dd></div>}
        {image.originalWidth && image.originalHeight && <div><dt>Original dimensions</dt><dd>{image.originalWidth} × {image.originalHeight} pixels</dd></div>}
        {image.originalSha256 && <div><dt>Original SHA-256</dt><dd><code>{image.originalSha256}</code></dd></div>}
        <div><dt>Licence</dt><dd><a href={image.licenceUrl} target="_blank" rel="noopener noreferrer">{image.licence} <span aria-hidden="true">↗</span></a></dd></div>
        {image.licenceEvidenceUrl && <div><dt>Reuse conditions</dt><dd><a href={image.licenceEvidenceUrl} target="_blank" rel="noopener noreferrer">Publisher's licence statement <span aria-hidden="true">↗</span></a></dd></div>}
        {image.licenceDocumentPath && <div><dt>Full licence and disclaimer</dt><dd><a href={String(image.licenceDocumentPath)}>Read the retained original licence conditions</a></dd></div>}
        {image.derivativesNote && <div><dt>Display preparation</dt><dd>{image.derivativesNote}</dd></div>}
        <div><dt>Local copy</dt><dd>The reader displays a local copy so the image remains available if the original page changes.</dd></div>
      </dl>
    </section>
    <p><a class="text-link" href="/images/">← Back to image archive</a></p>
  </article>
</Layout> : <Layout title="Image not found"><section class="not-found"><h1>Image not found</h1><a href="/images/">Open the image archive</a></section></Layout>}
