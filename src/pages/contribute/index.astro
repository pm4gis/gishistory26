---
import Layout from '../../layouts/Layout.astro';
import {contributionDraft,contributionMailtoUrl,contributionText,contributionRecipient} from '../../lib/passage-contributions.mjs';
const draft=contributionDraft();
const params=new URLSearchParams({view:'cm',fs:'1',to:contributionRecipient,su:draft.subject,body:draft.body});
const gmail='https://mail.google.com/mail/?'+params.toString();
const outlook='https://outlook.live.com/mail/0/deeplink/compose?'+new URLSearchParams({to:contributionRecipient,subject:draft.subject,body:draft.body}).toString();
---
<Layout title="Email a contribution · NZ GIS History" description="Open a pre-addressed email draft in your usual mail application or webmail to contribute corrections, documents and photographs.">
 <div class="wrap narrative email-options-page">
  <p class="eyebrow">Contributions and corrections</p>
  <h1>Email a contribution</h1>
  <p>Choose your email service. A new email draft opens addressed to <strong>{contributionRecipient}</strong>, with the subject and questions already included. Attach photographs, maps, screenshots or documents using your email service's attachment button, then send it.</p>

  <div id="contribution-context" class="contribution-context" hidden>
   <p id="contribution-chapter"></p>
   <p id="contribution-passage"></p>
   <p><a id="contribution-reference" href="#"></a></p>
  </div>

  <div class="actions email-options-buttons">
   <a id="contribution-mailto" class="button primary" href={contributionMailtoUrl(draft.subject,draft.body)}>Open my email app →</a>
   <a id="contribution-gmail" class="button" href={gmail} target="_blank" rel="noopener noreferrer">Gmail in browser ↗</a>
   <a id="contribution-outlook" class="button" href={outlook} target="_blank" rel="noopener noreferrer">Outlook in browser ↗</a>
  </div>
  <p class="email-options-note">The first option uses your browser's email setting. It can open Apple Mail, Gmail, Outlook, Thunderbird, another installed email app or a registered webmail service. If it does nothing, choose a browser option above or open your preferred email service and paste the prepared message below.</p>

  <div class="email-copy-options">
   <div class="actions">
    <button id="contribution-copy" class="button" type="button">Copy prepared email</button>
    <button id="contribution-copy-address" class="button" type="button">Copy email address</button>
   </div>
   <p id="contribution-status" class="contribution-status" role="status" aria-live="polite">No message is sent by this page.</p>
   <details class="contribution-preview">
    <summary>Show prepared email to copy manually</summary>
    <pre id="contribution-message">{contributionText(draft)}</pre>
   </details>
  </div>
 </div>
 <script>
  import {contributionContextFromSearch,contributionDraft,contributionMailtoUrl,contributionText,contributionRecipient} from '../../lib/passage-contributions.mjs';
  const context=contributionContextFromSearch(window.location.search);
  const current=contributionDraft(context);
  const mail=document.getElementById('contribution-mailto') as HTMLAnchorElement|null;
  const gmail=document.getElementById('contribution-gmail') as HTMLAnchorElement|null;
  const outlook=document.getElementById('contribution-outlook') as HTMLAnchorElement|null;
  const preview=document.getElementById('contribution-message');
  const status=document.getElementById('contribution-status');
  if(mail)mail.href=contributionMailtoUrl(current.subject,current.body);
  if(gmail)gmail.href='https://mail.google.com/mail/?'+new URLSearchParams({view:'cm',fs:'1',to:contributionRecipient,su:current.subject,body:current.body}).toString();
  if(outlook)outlook.href='https://outlook.live.com/mail/0/deeplink/compose?'+new URLSearchParams({to:contributionRecipient,subject:current.subject,body:current.body}).toString();
  if(preview)preview.textContent=contributionText(current);
  if(context.chapter||context.passage||context.reference){
   const box=document.getElementById('contribution-context');
   if(box)box.hidden=false;
   const chapter=document.getElementById('contribution-chapter');
   const passage=document.getElementById('contribution-passage');
   const ref=document.getElementById('contribution-reference') as HTMLAnchorElement|null;
   if(chapter){chapter.textContent=context.chapter?'Chapter: '+context.chapter:'';chapter.hidden=!context.chapter;}
   if(passage){passage.textContent=context.passage?'Passage: '+context.passage:'';passage.hidden=!context.passage;}
   if(ref){ref.textContent=context.reference?'Read the referenced passage':'';ref.hidden=!context.reference;if(context.reference)ref.href=context.reference;}
  }
  async function copy(text:string,success:string){
   try{await navigator.clipboard.writeText(text);if(status)status.textContent=success;return;}catch{}
   const fallback=document.createElement('textarea');
   fallback.value=text;
   fallback.setAttribute('readonly','');
   fallback.style.position='fixed';fallback.style.opacity='0';
   document.body.append(fallback);
   fallback.select();
   let copied=false;
   try{copied=document.execCommand('copy')}catch{}
   fallback.remove();
   if(status)status.textContent=copied?success:'Select the prepared text above and copy it into your email.';
   if(!copied){const details=preview?.closest('details');if(details)details.open=true;}
  }
  document.getElementById('contribution-copy')?.addEventListener('click',()=>copy(contributionText(current),'Prepared email copied. Paste it into your email service and attach any files.'));
  document.getElementById('contribution-copy-address')?.addEventListener('click',()=>copy(contributionRecipient,'Email address copied.'));
 </script>
</Layout>
<style>
 .email-options-page{max-width:940px;padding-block:35px 65px}
 .email-options-page>p:not(.eyebrow){max-width:78ch}
 .email-options-buttons{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:25px 0 15px}
 .email-options-buttons a{max-width:100%;text-align:center}
 .email-options-note{color:var(--muted);font-size:.95rem;line-height:1.7}
 .contribution-context{margin:22px 0;padding:14px 20px;border-left:3px solid var(--accent);background:var(--raised);border-radius:5px}
 .contribution-context p{margin:5px 0;overflow-wrap:anywhere}
 .email-copy-options{margin-top:22px;border-top:1px solid var(--line);padding-top:20px}
 .contribution-status{font-size:14px;color:var(--muted);margin:12px 0}
 .contribution-preview{max-width:780px;border:1px solid var(--line);border-radius:12px;padding:15px 18px}
 .contribution-preview summary{cursor:pointer;font-weight:600}
 .contribution-preview pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.7;margin:18px 0}
 @media(max-width:600px){.email-options-buttons{flex-direction:column;align-items:stretch}.email-options-buttons .button{width:100%}}
</style>
