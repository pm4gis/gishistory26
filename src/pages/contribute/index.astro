---
import Layout from '../../layouts/Layout.astro';
import {siteContributionGmailUrl} from '../../lib/passage-contributions.mjs';
const gmail=siteContributionGmailUrl();
---
<Layout title="Contribute · NZ GIS History" description="Open a pre-addressed Gmail draft to contribute to NZ GIS History.">
 <div class="wrap narrative">
  <h1>Contribute to NZ GIS History</h1>
  <p><a id="gmail-draft" class="button primary" href={gmail}>Open Gmail draft →</a></p>
  <p>Gmail opens in your browser. Review your message and choose Send when you're ready.</p>
 </div>
 <script>
  import {contributionContextFromSearch,contributionDraft,contributionGmailUrl} from '../../lib/passage-contributions.mjs';
  const draft=contributionDraft(contributionContextFromSearch(window.location.search));
  const url=contributionGmailUrl(draft.subject,draft.body);
  const link=document.querySelector<HTMLAnchorElement>('#gmail-draft');
  if(link)link.href=url;
  window.location.replace(url);
 </script>
</Layout>
