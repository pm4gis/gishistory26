---
import Layout from '../../layouts/Layout.astro';
import ContributeForm from '../../components/ContributeForm.svelte';
---
<Layout title="Contribute or correct · NZ GIS History" description="Contribute evidence, memories, documents or corrections to A History of GIS in New Zealand, using an editable email draft.">
 <div class="wrap narrative">
  <p class="eyebrow">Contributions and corrections</p>
  <h1>Contribute to NZ GIS History</h1>
  <p>Have a correction, an account of an early GIS project, a name we have missed, or a map or photograph that belongs in the history? Prepare a message below. When you come here from a chapter, its passage link is included automatically.</p>
  <ContributeForm client:load/>
  <p><a href="/about/">About the project and its sources →</a></p>
 </div>
</Layout>
