---
const {title,pdfPath,previous=null,next=null,position,total,sourceOnly=false,sourceUrl=null,thumbnailPath=null}=Astro.props;
const pdfUrl=pdfPath+'#view=FitH&navpanes=0';
---
<article class="publication-reader" data-pagefind-body>
 <header class="publication-reader-bar">
  <div class="publication-reader-heading">
   <a class="publication-reader-back" href="/publications/">← Publications</a>
   <h1>{title}</h1>
  </div>
  <div class="publication-reader-controls">
   {position!=null&&total!=null&&<span class="publication-reader-count">{position} of {total}</span>}
   {(previous||next)&&<nav class="publication-reader-nav" aria-label="Browse publications">
    {previous?<a href={previous.url} rel="prev" aria-label={'Previous publication: '+previous.title}>← Previous</a>:<span class="inactive" aria-hidden="true">← Previous</span>}
    {next?<a href={next.url} rel="next" aria-label={'Next publication: '+next.title}>Next →</a>:<span class="inactive" aria-hidden="true">Next →</span>}
   </nav>}
   {!sourceOnly&&<><a class="publication-reader-open" href={pdfPath} target="_blank" rel="noopener noreferrer">Open document ↗</a><button class="publication-reader-expand" type="button" data-pdf-expand aria-label="Read PDF full screen">Full screen</button></>}
  </div>
 </header>
 {sourceOnly?(
  <section class="publication-reader-source-only" aria-label={'Publisher record for '+title}>
   {thumbnailPath&&<img src={thumbnailPath} alt="" loading="eager" width="240" height="320"/>}
   <div>
    <h2>Report held in the publisher catalogue</h2>
    <p>The report is attached to the publisher’s catalogue entry. Open that entry and select the report under <strong>Attachments</strong>.</p>
    <p><a class="button" href={sourceUrl||pdfPath} target="_blank" rel="noopener noreferrer">View publisher record ↗</a></p>
   </div>
  </section>
 ):(
  <section class="publication-reader-frame" id="publication-pdf" aria-label={'Reading '+title}>
   <object data={pdfUrl} type="application/pdf" aria-label={'Read PDF: '+title} class="publication-reader-object">
    <p class="publication-reader-fallback">Your browser could not display this PDF here. <a href={pdfPath} target="_blank" rel="noopener noreferrer">Open the PDF at its publisher</a>.</p>
   </object>
  </section>
 )}
 <div class="publication-reader-below">
  <nav class="publication-reader-bottom-nav" aria-label="Continue reading publications">
   {previous?<a href={previous.url} rel="prev">← Previous</a>:<span></span>}
   <a href="/publications/">All publications</a>
   {next?<a href={next.url} rel="next">Next →</a>:<span></span>}
  </nav>
  <section class="publication-reader-details" aria-label="About this publication">
   <slot />
  </section>
 </div>
</article>
<script>
 const expand=document.querySelector<HTMLButtonElement>('[data-pdf-expand]');
 const frame=document.getElementById('publication-pdf');
 if(expand && frame){
  if(typeof frame.requestFullscreen!=='function') expand.hidden=true;
  else expand.addEventListener('click',()=>{
   if(document.fullscreenElement) {void document.exitFullscreen();}
   else {void frame.requestFullscreen();}
  });
 }
</script>
<style>
 .publication-reader{width:100%;max-width:none;margin:0 auto;padding:12px clamp(8px,1.15vw,22px) 54px}
 .publication-reader-bar{min-height:62px;display:flex;gap:16px;align-items:center;justify-content:space-between;padding:0 2px 10px}
 .publication-reader-heading{min-width:0;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
 .publication-reader-back{white-space:nowrap;font-size:13px}
 .publication-reader-heading h1{font-size:clamp(18px,1.45vw,24px);line-height:1.3;letter-spacing:normal;margin:0;font-weight:650;max-width:70ch}
 .publication-reader-controls{display:flex;align-items:center;gap:12px;flex-shrink:0}
 .publication-reader-count{font-size:13px;color:var(--muted);white-space:nowrap}
 .publication-reader-nav{display:flex;gap:5px}
 .publication-reader-nav a,.publication-reader-expand,.publication-reader-open{font-size:13px;white-space:nowrap;border:1px solid var(--line);border-radius:8px;min-height:38px;padding:8px 12px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;color:var(--text);background:var(--surface)}
 .publication-reader-nav a:hover,.publication-reader-expand:hover,.publication-reader-open:hover{border-color:var(--accent);background:var(--raised)}
 .publication-reader-nav .inactive{display:none}
 .publication-reader-frame{width:100%;height:calc(100dvh - 153px);min-height:680px;max-height:none;overflow:hidden;border:1px solid var(--line);border-radius:7px;background:#e5e5e5}
 .publication-reader-object{display:block;width:100%;height:100%;border:0;background:#eee;color:#111}
 .publication-reader-fallback{color:#111;padding:24px}
 .publication-reader-source-only{min-height:380px;display:flex;align-items:center;justify-content:center;gap:32px;padding:36px 20px;border:1px solid var(--line);border-radius:7px;background:var(--surface)}
 .publication-reader-source-only img{display:block;width:min(240px,30vw);height:auto;max-height:320px;object-fit:contain;flex:none}
 .publication-reader-source-only>div{max-width:58ch}
 .publication-reader-source-only h2{font-size:clamp(21px,2.4vw,32px);margin:0 0 9px}
 .publication-reader-source-only p{color:var(--muted)}
 .publication-reader-frame:fullscreen{width:100vw;height:100dvh;min-height:0;border:0;border-radius:0;padding:0}
 .publication-reader-below{max-width:980px;margin:0 auto;padding:24px 12px 0}
 .publication-reader-bottom-nav{display:flex;gap:16px;justify-content:space-between;align-items:center;padding:8px 0 22px;border-bottom:1px solid var(--line);font-size:15px}
 .publication-reader-details{padding-top:12px;overflow-wrap:anywhere}
 @media(max-width:1050px){.publication-reader-bar{align-items:flex-start;flex-direction:column;gap:10px}.publication-reader-controls{width:100%;justify-content:flex-end}.publication-reader-frame{height:calc(100dvh - 212px);min-height:620px}}
 @media(max-width:600px){.publication-reader-source-only{flex-direction:column;min-height:0;padding:24px 18px;gap:12px}.publication-reader-source-only img{width:140px;max-height:185px}.publication-reader{padding:8px 6px 38px}.publication-reader-bar{padding:2px 8px 12px;gap:8px}.publication-reader-heading{display:block}.publication-reader-heading h1{margin:6px 0 0;font-size:19px}.publication-reader-controls{justify-content:space-between;gap:6px;flex-wrap:wrap}.publication-reader-nav a,.publication-reader-expand{font-size:12px;padding:8px 9px;min-height:36px}.publication-reader-count{font-size:12px}.publication-reader-frame{height:calc(100dvh - 205px);min-height:480px;border-radius:3px}.publication-reader-below{padding:14px 12px 0}.publication-reader-bottom-nav{gap:8px;font-size:13px;flex-wrap:wrap}}

 .publication-reader-open{display:none}
 @media(max-width:650px){
  .publication-reader-open{display:inline-flex}
  .publication-reader-bar{padding:4px 8px 10px;gap:8px}
  .publication-reader-heading h1{font-size:clamp(17px,4.8vw,23px);line-height:1.3;overflow-wrap:anywhere}
  .publication-reader-controls{display:grid;grid-template-columns:auto 1fr auto;gap:7px;align-items:center;width:100%}
  .publication-reader-nav{justify-content:center}
  .publication-reader-nav a,.publication-reader-open{font-size:13px;min-height:44px;padding:9px}
  .publication-reader-expand{display:none}
  .publication-reader-frame{height:calc(100dvh - 226px);min-height:345px}
  .publication-reader-bottom-nav{display:grid;grid-template-columns:1fr auto 1fr;gap:8px}
  .publication-reader-bottom-nav a:last-child{text-align:right}
 }
 @media(max-width:375px){
  .publication-reader-controls{grid-template-columns:auto 1fr}
  .publication-reader-open{grid-column:1/-1;justify-content:center}
  .publication-reader-frame{height:calc(100dvh - 260px);min-height:310px}
 }
</style>
