---
import library from '../data/landscape-images.json';

interface Props {
  placement: string;
  priority?: boolean;
  className?: string;
}
const {placement, priority = false, className = ''} = Astro.props;
const image = (library.images as any[]).find((item: any) => item.placement === placement && item.rightsStatus === 'approved');
const sources = image?.variants;
const width = sources?.hero?.width ?? sources?.feature?.width;
const height = sources?.hero?.height ?? sources?.feature?.height;
const sourceSet = sources ? ['card','feature','hero'].filter(k => sources[k]).map(k => sources[k].path + ' ' + sources[k].width + 'w').join(', ') : '';
---
{image && sources && (
  <figure class:list={['landscape-photo', className]}>
    <img
      src={sources.feature.path}
      srcset={sourceSet}
      sizes={placement === 'home-hero' ? '(max-width: 850px) 100vw, 1100px' : '(max-width: 850px) 100vw, 1000px'}
      width={width}
      height={height}
      alt={image.altText}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <figcaption>{image.attribution} · <a href={image.sourceLayerUrl} rel="noopener noreferrer">Imagery source</a> · <a href={image.licenceUrl} rel="noopener noreferrer">Licence</a></figcaption>
  </figure>
)}
