---
import '../styles/site.css';
import {pageSchema,safeJsonLd,conciseDescription} from '../lib/seo.mjs';
import {getCollection} from 'astro:content';
import {siteContributionPageUrl} from '../lib/passage-contributions.mjs';
import {PALETTE_ORDER,PALETTE_NAMES,PALETTE_TOKENS} from '../lib/appearance.mjs';
const {title='A History of GIS in New Zealand',description='Read the history of GIS in New Zealand. Explore connected people, organisations, events and themes.',structuredData=[],noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const metaDescription=conciseDescription(description);
const jsonLd=safeJsonLd(pageSchema({url:canonical.href,title,description:metaDescription,entities:structuredData}));
const choices=PALETTE_ORDER.map(id=>({id,label:PALETTE_NAMES[id as keyof typeof PALETTE_NAMES],dark:PALETTE_TOKENS[id].dark,light:PALETTE_TOKENS[id].light}));
const currentPath=Astro.url.pathname;
const contributionHref=currentPath==='/contribute/'?'/contribute/':siteContributionPageUrl(title,canonical.href);
const isThemesRoute=currentPath.startsWith('/themes/');
const menuThemes=(await getCollection('themes'))
 .map(entry=>({slug:entry.data.slug,title:entry.data.title}))
 .sort((a,b)=>a.title.localeCompare(b.title,'en-NZ'));
const menuDatasets=(await getCollection('records'))
 .filter(entry=>entry.data.kind==='Dataset')
 .map(entry=>({slug:entry.data.slug,name:entry.data.name,category:entry.data.category||'Other datasets'}))
 .sort((a,b)=>a.name.localeCompare(b.name,'en-NZ'));
---
<!doctype html>
<html lang="en-NZ">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <title>{title}</title><meta name="description" content={metaDescription}/><link rel="canonical" href={canonical}/>
 {noindex&&<meta name="robots" content="noindex,follow"/>}
 <script type="application/ld+json" set:html={jsonLd}></script>
 <meta property="og:title" content={title}/><meta property="og:description" content={metaDescription}/><meta property="og:type" content="website"/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:image" content="https://history.pm4gis.nz/assets/social/nzgis-selected-20261013.jpg"/>
 <meta property="og:image:secure_url" content="https://history.pm4gis.nz/assets/social/nzgis-selected-20261013.jpg"/>
 <meta property="og:image:type" content="image/jpeg"/>
 <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
 <meta property="og:image:alt" content="User-selected NZ GIS History artwork with a slate-blue background, topographic map, bathymetric chart, historical aerial photograph and GPS receiver"/>
 <meta name="twitter:card" content="summary_large_image"/>
 <meta name="twitter:title" content={title}/><meta name="twitter:description" content={metaDescription}/>
 <meta name="twitter:image" content="https://history.pm4gis.nz/assets/social/nzgis-selected-20261013.jpg"/>
 <meta name="twitter:image:alt" content="User-selected NZ GIS History artwork showing aerial photography, mapping, bathymetry and a GPS receiver"/>
 <script is:inline>
  // Apply the saved theme before first paint, including legacy selections.
  try {
   let saved=null;try{saved=JSON.parse(localStorage.getItem('nzgis-appearance-v2')||'null')}catch{}
   let palette='slate',mode='dark';
   if(saved&&typeof saved==='object'){
    if(['slate','coastal','forest','archive','bubblegum'].includes(saved.palette))palette=saved.palette;
    if(['dark','light','system'].includes(saved.mode))mode=saved.mode;
   }else{
    let old=localStorage.getItem('nzgis-theme');
    if(!old){try{old=JSON.parse(localStorage.getItem('nzgis-colour-palette-v1')||'null')}catch{}}
    const legacy={'night':['coastal','dark'],'dark-night':['coastal','dark'],
     'forest':['forest','dark'],'dark-forest':['forest','dark'],
     'paper':['archive','light'],'light-paper':['archive','light'],
     'mist':['coastal','light'],'light-mist':['coastal','light']};
    if(legacy[old]){[palette,mode]=legacy[old]}
   }
   const resolved=mode==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):mode;
   document.documentElement.dataset.palette=palette;
   document.documentElement.dataset.appearance=resolved;
   document.documentElement.style.colorScheme=resolved;
  }catch{
   document.documentElement.dataset.palette='slate';
   document.documentElement.dataset.appearance='dark';
  }
 </script>
</head>
<body>
 <a class="skip" href="#main">Skip to content</a>
 <header class="topbar">
  <a class="brand" href="/"><small>NEW ZEALAND</small>GIS History</a>
  <nav class="nav nav--desktop" aria-label="Main navigation">
   <a href="/read/">Chapters</a><a href="/timeline/">Timeline</a><a href="/browse/">People &amp; organisations</a><a href="/network/" aria-current={currentPath==='/network/'?'page':undefined}>Connections</a>
   <details class="nav-dropdown nav-dropdown--datasets">
    <summary class="nav-dataset-toggle">Datasets <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-dropdown-panel nav-dataset-panel" role="group" aria-label="Dataset shortcuts">
     <a class="nav-dropdown-all" href="/datasets/" aria-current={currentPath==='/datasets/'?'page':undefined}>Explore all datasets <span aria-hidden="true">↗</span></a>
     <p class="nav-dropdown-caption">National and historical datasets</p>
     <div class="nav-theme-grid">
      {menuDatasets.map(record=><a href={'/datasets/'+record.slug+'/'} aria-current={currentPath==='/datasets/'+record.slug+'/'?'page':undefined}>{record.name}</a>)}
     </div>
    </div>
   </details>
   <details class="nav-dropdown nav-dropdown--themes">
    <summary class:list={['nav-theme-toggle',isThemesRoute&&'is-current']}>Themes <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-dropdown-panel" role="group" aria-label="Theme shortcuts">
     <a class="nav-dropdown-all" href="/themes/" aria-current={currentPath==='/themes/'?'page':undefined}>Explore all themes <span aria-hidden="true">↗</span></a>
     <div class="nav-theme-grid">
      {menuThemes.map(theme=><a href={'/themes/'+theme.slug+'/'} aria-current={currentPath==='/themes/'+theme.slug+'/'?'page':undefined}>{theme.title}</a>)}
     </div>
    </div>
   </details>
   <a href="/publications/" aria-current={currentPath.startsWith('/publications/')?'page':undefined}>Publications</a><a href="/search/">Search</a><a href="/about/">About</a><a class="button nav-contribute" href={contributionHref}>Contribute</a>
  </nav>
  <div class="topbar-tools">
   <div class="appearance-control">
    <button id="palette" type="button" aria-label="Open appearance settings" aria-controls="appearance-panel" aria-expanded="false">◐ <span>Appearance</span></button>
    <section id="appearance-panel" class="appearance-panel" role="group" aria-label="Appearance settings" hidden>
     <div class="appearance-heading"><strong>Appearance</strong><button class="appearance-close" type="button" aria-label="Close appearance settings">×</button></div>
     <fieldset class="appearance-fieldset"><legend>Mode</legend>
      <div class="appearance-modes" role="group" aria-label="Choose light or dark mode">
       <button type="button" data-appearance-mode="dark" aria-pressed="false">Dark</button>
       <button type="button" data-appearance-mode="light" aria-pressed="false">Light</button>
       <button type="button" data-appearance-mode="system" aria-pressed="false">System</button>
      </div>
     </fieldset>
     <fieldset class="appearance-fieldset"><legend>Colour palette</legend>
      <div class="appearance-choices">
       {choices.map(choice=><button class="appearance-choice" type="button" data-appearance-palette={choice.id} aria-pressed="false">
        <span class="appearance-swatch" aria-hidden="true" style={`--swatch-dark:${choice.dark.bg};--swatch-dark-accent:${choice.dark.accent};--swatch-light:${choice.light.bg};--swatch-light-accent:${choice.light.accent}`}></span>
        <span>{choice.label}</span>
       </button>)}
      </div>
     </fieldset>
    </section>
   </div>
   <details class="mobile-menu">
    <summary aria-label="Open navigation menu"><span class="hamburger-icon" aria-hidden="true">☰</span><span>Menu</span></summary>
    <nav class="nav nav--mobile" aria-label="Mobile navigation">
     <a href="/read/">Chapters</a><a href="/timeline/">Timeline</a><a href="/browse/">People &amp; organisations</a><a href="/network/" aria-current={currentPath==='/network/'?'page':undefined}>Connections</a>
     <details class="nav-dropdown nav-dropdown--datasets">
    <summary class="nav-dataset-toggle">Datasets <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-dropdown-panel nav-dataset-panel" role="group" aria-label="Dataset shortcuts">
     <a class="nav-dropdown-all" href="/datasets/" aria-current={currentPath==='/datasets/'?'page':undefined}>Explore all datasets <span aria-hidden="true">↗</span></a>
     <p class="nav-dropdown-caption">National and historical datasets</p>
     <div class="nav-theme-grid">
      {menuDatasets.map(record=><a href={'/datasets/'+record.slug+'/'} aria-current={currentPath==='/datasets/'+record.slug+'/'?'page':undefined}>{record.name}</a>)}
     </div>
    </div>
   </details>
     <details class="nav-dropdown nav-dropdown--themes">
    <summary class:list={['nav-theme-toggle',isThemesRoute&&'is-current']}>Themes <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-dropdown-panel" role="group" aria-label="Theme shortcuts">
     <a class="nav-dropdown-all" href="/themes/" aria-current={currentPath==='/themes/'?'page':undefined}>Explore all themes <span aria-hidden="true">↗</span></a>
     <div class="nav-theme-grid">
      {menuThemes.map(theme=><a href={'/themes/'+theme.slug+'/'} aria-current={currentPath==='/themes/'+theme.slug+'/'?'page':undefined}>{theme.title}</a>)}
     </div>
    </div>
   </details>
     <a href="/publications/" aria-current={currentPath.startsWith('/publications/')?'page':undefined}>Publications</a><a href="/search/">Search</a><a href="/about/">About</a><a class="button nav-contribute" href={contributionHref}>Contribute</a>
    </nav>
   </details>
  </div>
 </header>
 <main id="main"><slot/></main>
 <footer class="footer"><span>A History of GIS in New Zealand</span><div class="actions"><a href="/history/">Short history</a><a href="/about/">About &amp; sources</a><a href={contributionHref}>Email options</a><a href="/network/">Connections</a></div></footer>
 <script>
  import {PALETTE_NAMES,PALETTE_TOKENS,readAppearance,resolveAppearance,saveAppearance} from '../lib/appearance.mjs';
  const root=document.documentElement;
  const toggle=document.getElementById('palette') as HTMLButtonElement|null;
  const panel=document.getElementById('appearance-panel');
  const closeButton=document.querySelector<HTMLButtonElement>('.appearance-close');
  const media=window.matchMedia('(prefers-color-scheme: dark)');
  let storage:Storage|undefined;
  try{storage=window.localStorage}catch{}
  let choice=readAppearance(storage);
  function showSettings(open:boolean){
   if(!panel||!toggle)return;
   panel.hidden=!open;
   toggle.setAttribute('aria-expanded',String(open));
   if(open){
    document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach(menu=>{menu.open=false;});
    mobileMenu?.removeAttribute('open');
    panel.querySelector<HTMLButtonElement>('button[data-appearance-mode]')?.focus();
   }
   else toggle.focus();
  }
  function sync(){
   const scheme=resolveAppearance(choice.mode,media.matches);
   root.dataset.palette=choice.palette;
   root.dataset.appearance=scheme;
   root.style.colorScheme=scheme;
   if(toggle)toggle.setAttribute('aria-label','Appearance settings: '+PALETTE_NAMES[choice.palette as keyof typeof PALETTE_NAMES]+', '+choice.mode+'. Open settings');
   document.querySelectorAll<HTMLButtonElement>('[data-appearance-mode]').forEach(button=>{
    button.setAttribute('aria-pressed',String(button.dataset.appearanceMode===choice.mode));
   });
   document.querySelectorAll<HTMLButtonElement>('[data-appearance-palette]').forEach(button=>{
    button.setAttribute('aria-pressed',String(button.dataset.appearancePalette===choice.palette));
   });
  }
  toggle?.addEventListener('click',()=>showSettings(panel?.hidden??true));
  closeButton?.addEventListener('click',()=>showSettings(false));
  panel?.querySelectorAll<HTMLButtonElement>('[data-appearance-mode]').forEach(button=>
   button.addEventListener('click',()=>{
    const mode=button.dataset.appearanceMode;
    if(mode==='dark'||mode==='light'||mode==='system'){choice={...choice,mode};saveAppearance(storage,choice);sync();}
   })
  );
  panel?.querySelectorAll<HTMLButtonElement>('[data-appearance-palette]').forEach(button=>
   button.addEventListener('click',()=>{
    const palette=button.dataset.appearancePalette;
    if(palette&&Object.hasOwn(PALETTE_TOKENS,palette)){choice={...choice,palette};saveAppearance(storage,choice);sync();}
   })
  );
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!panel?.hidden)showSettings(false)});
  document.addEventListener('pointerdown',event=>{
   if(panel&&!panel.hidden&&!document.querySelector('.appearance-control')?.contains(event.target as Node)){
    panel.hidden=true;toggle?.setAttribute('aria-expanded','false');
   }
  });
  media.addEventListener('change',()=>{if(choice.mode==='system')sync()});
  sync();
  const mobileMenu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
  mobileMenu?.addEventListener('keydown',(event)=>{if(event.key==='Escape'){mobileMenu.open=false;mobileMenu.querySelector('summary')?.focus();}});
  mobileMenu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mobileMenu.open=false;}));
  document.addEventListener('pointerdown',(event)=>{if(mobileMenu?.open&&!mobileMenu.contains(event.target as Node))mobileMenu.open=false;});
  const navMenus=Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown'));
  for(const menu of navMenus){
   const summary=menu.querySelector<HTMLElement>('summary');
   const links=Array.from(menu.querySelectorAll<HTMLAnchorElement>('.nav-dropdown-panel a'));
   menu.addEventListener('toggle',()=>{
    if(!menu.open)return;
    navMenus.forEach(other=>{if(other!==menu)other.open=false;});
    if(panel&&!panel.hidden){panel.hidden=true;toggle?.setAttribute('aria-expanded','false');}
   });
   menu.addEventListener('keydown',(event)=>{
    if(event.key==='Escape'&&menu.open){
     event.preventDefault();
     event.stopPropagation();
     menu.open=false;
     summary?.focus();
    }else if(event.key==='ArrowDown'||event.key==='ArrowUp'){
     event.preventDefault();
     if(!menu.open)menu.open=true;
     const index=links.indexOf(document.activeElement as HTMLAnchorElement);
     const offset=event.key==='ArrowDown'?1:-1;
     links[index<0?(offset>0?0:links.length-1):(index+offset+links.length)%links.length]?.focus();
    }
   });
  }
  mobileMenu?.addEventListener('toggle',()=>{
   if(!mobileMenu.open)mobileMenu.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach(menu=>{menu.open=false;});
  });
  document.addEventListener('pointerdown',(event)=>{
   for(const menu of navMenus){
    if(menu.open&&!menu.contains(event.target as Node))menu.open=false;
   }
  });
 </script>
</body>
</html>
